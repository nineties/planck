# Copyright (C) 2026 nineties

import_lib("list")
import_lib("string")
import_lib("table")

args := os_argv()
in_path := args[1]
out_path := args[2]

rows := table.new()
case_names := []
ref_names := []
ref_rows := table.new()
machine_text := ""

machine(os, cpu, nproc) := {
    machine_text = f"{os}, {cpu}, {nproc} cores"
}

commit_url := "https://github.com/nineties/planck/commit"
short(commit) := str_sub(commit, 0, 7)
version_label(ref, commit) := f"{ref} ({short(commit)})"
commit_link(commit) := f"[{short(commit)}]({commit_url}/{commit})"
or_dash(s) := if (s == "") "-" else s

result(name, ref, commit, planck0, date, rounds, t, heap, gcs) := {
    label := version_label(ref, commit)
    key := f"{name}/{label}"
    if (not list.member(name, case_names)) case_names = list.append(case_names, [name])
    if (not list.member(label, ref_names)) {
        ref_names = list.append(ref_names, [label])
        table.set(ref_rows, label, (ref, commit, planck0, date))
    }
    table.set(rows, key, (t, heap, gcs))
}

load(in_path)

pad3(n) := if (n < 10) f"00{n}" else if (n < 100) f"0{n}" else f"{n}"
milli(x) := f"{x // 1000}.{pad3(x % 1000)}"
seconds(ns) := milli((ns + 500000) // 1000000)
mebibytes(bytes) := milli(bytes * 1000 // 1048576)

cell(name, ref, k, show) := {
    row := table.get(rows, f"{name}/{ref}", none)
    if (row == none) "-"
    else {
        v := arg(row, k)
        if (v == none) "-" else show(v)
    }
}

table_lines(title, k, show, only_cases) := {
    head := string.join(" | ", ref_names)
    sep := string.join("|", list.map(r -> "---:", ref_names))
    body := list.map(name -> f"| {name} | {string.join(" | ", list.map(ref -> cell(name, ref, k, show), ref_names))} |", only_cases)
    header := [f"## {title}\n", f"| benchmark | {head} |", f"|---|{sep}|"]
    string.join("\n", list.append(list.append(header, body), [""]))
}

cases_without_startup := list.filter(name -> name != "startup", case_names)

run_line(label) := {
    r := table.get(ref_rows, label, none)
    f"| {label} | {commit_link(arg(r, 1))} | {str_sub(arg(r, 3), 0, 10)} | {arg(r, 2)} |"
}

runs := list.map(run_line, ref_names)

text := string.join("\n", [
    "## Machine\n",
    f"Every version is measured on the same machine: {or_dash(machine_text)}.\n",
    "## Versions\n",
    "Each column of the tables below is one measured version, named by its tag or branch and the short commit. The commit is in this table.\n",
    "| version | commit | date | planck0 |",
    "|---|---|---|---|",
    string.join("\n", runs),
    "",
    table_lines("Time per benchmark (seconds, median)", 0, seconds, case_names),
    table_lines("Allocated memory per benchmark (MiB)", 1, mebibytes, cases_without_startup),
    ""
])
os_write_file(out_path, text)
