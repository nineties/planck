import_lib("list")

xs := list.range(0, 1500)
ys := list.map(x -> x * 7 % 1009, xs)
zs := list.filter(x -> x % 2 == 0, ys)
print(list.length(zs))
print(list.sum(list.map(x -> x + 1, zs)))
sorted := list.sort((a, b) -> a < b, ys)
print(list.nth(sorted, 0))
print(list.nth(sorted, 1499))
print(list.length(list.append(xs, ys)))
print(list.any(x -> x == 1008, ys))
print(list.index_of(1008, ys))
print(list.length(list.zip(xs, ys)))
