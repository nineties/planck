macro Twice{x} := `(!x + !x)
macro Square{x} := `(!x * !x)
macro Fourth{x} := `Square{Square{!x}}
macro unless(c, e) := `if (not !c) !e

fun go
go = (0, acc) -> acc
   | (n, acc) -> go(n - 1, acc + Twice{n} + Fourth{2})

print(go(6000, 0))

fun spin
spin = (0) -> none
     | (n) -> { unless(n < 0, none); spin(n - 1) }
spin(6000)

print(eval('(Twice{4})))
i := 0
t := 0
while (i < 10000) {
    t = t + eval('(Fourth{3}))
    i = i + 1
}
print(t)
