# Copyright (C) 2026 nineties

import_lib("list")
import_lib("string")
import_lib("table")
import_lib("pretty")

args := os_argv()
out_path := args[1]
cur_path := args[2]

meta := table.new()
for (line in string.split(unwrap(os_read_file(args[3])), "\n")) {
    parts := string.split(line, "=")
    if (list.length(parts) > 1) table.set(meta, list.nth(parts, 0),
        string.join("=", list.drop(parts, 1)))
}

acc_table := table.new()
acc_names := []

sample(name, t, a, g) := {
    key := name
    if (not table.has(acc_table, key)) acc_names = key :: acc_names
    table.set(acc_table, key, (t, a, g) :: table.get(acc_table, key, []))
}

collect(path) := {
    acc_table = table.new()
    acc_names = []
    load(path)
    (acc_table, list.reverse(acc_names))
}

median(xs) := {
    sorted := list.sort((a, b) -> a < b, xs)
    n := list.length(sorted)
    if (n % 2 == 1) list.nth(sorted, n // 2)
    else (list.nth(sorted, n // 2 - 1) + list.nth(sorted, n // 2)) // 2
}

field_median(samples, k) := median(list.map(s -> arg(s, k), samples))

q(s) := pretty.quote_string(s)
get_meta(k) := table.get(meta, k, "")

cur := collect(cur_path)
cur_table := arg(cur, 0)
names := arg(cur, 1)

lines := f"machine({q(get_meta("os"))}, {q(get_meta("cpu"))}, {string.string_to_int(get_meta("nproc"))})\n"
for (name in names) {
    samples := table.get(cur_table, name, [])
    t := field_median(samples, 0)
    line := f"result({q(name)}, {q(get_meta("ref"))}, {q(get_meta("commit"))}, {q(get_meta("planck0"))}, {q(get_meta("date"))}, {string.string_to_int(get_meta("rounds"))}, {t}, {field_median(samples, 1)}, {field_median(samples, 2)})\n"
    lines = str_cat(lines, line)
}

old := match os_read_file(out_path) {
    Ok{t} -> t
  | Err{_} -> none
}
os_write_file(out_path, str_cat(if (old == none) "" else old, lines))
