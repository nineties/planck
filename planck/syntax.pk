" Syntax of planck "
" Copyright (C) 2026 nineties "

" The grammar is defined with the packrat parser of planck/peg.pk. The trees "
"   are the m-exprs "
" that eval takes, e.g. a + b is Apply{int_add, Tuple{a, b}}. M-expressions "
"   are a part of the syntax. "
" The file has three parts. The tokens, the functions that the actions call "
"   and the grammar of the grammar "
" (name ::= ...) are written in m-exprs. parse is replaced in the middle of "
"   the file, by the smallest syntax "
" that an action needs. The rest of the file is read by it, and the syntax of "
"   planck is declared with ::=. "

" === Tokens === "

Def{peg_reserved, Apply{table_new, Tuple{}}}
Apply{table_set, Tuple{peg_reserved, "if", true}}
Apply{table_set, Tuple{peg_reserved, "else", true}}
Apply{table_set, Tuple{peg_reserved, "while", true}}
Apply{table_set, Tuple{peg_reserved, "and", true}}
Apply{table_set, Tuple{peg_reserved, "or", true}}
Apply{table_set, Tuple{peg_reserved, "handle", true}}
Apply{table_set, Tuple{peg_reserved, "with", true}}
Apply{table_set, Tuple{peg_reserved, "perform", true}}
Apply{table_set, Tuple{peg_reserved, "match", true}}
Apply{table_set, Tuple{peg_reserved, "record", true}}
Apply{table_set, Tuple{peg_reserved, "for", true}}
Apply{table_set, Tuple{peg_reserved, "in", true}}
Apply{table_set, Tuple{peg_reserved, "return", true}}
Apply{table_set, Tuple{peg_reserved, "break", true}}
Apply{table_set, Tuple{peg_reserved, "continue", true}}
Apply{table_set, Tuple{peg_reserved, "fun", true}}
Apply{table_set, Tuple{peg_reserved, "module", true}}
Apply{table_set, Tuple{peg_reserved, "export", true}}
Apply{table_set, Tuple{peg_reserved, "macro", true}}
Apply{table_set, Tuple{peg_reserved, "import", true}}

" identifier: [A-Za-z_][A-Za-z0-9_]*[?!]? except the peg_reserved words and "
"   the f of f\"...\". "
" A ? or ! right after the name is part of it, but ! is not when = follows "
"   (x!=y is x != y). "
" rule_name is the same without the ? and !, for the names in a grammar, where "
"   x? is an optional x. "
Def{peg_scan_ident, Lambda{Tuple{p, suffix}, Do{
    Set{p, Apply{peg_skip_ws, Tuple{p}}},
    Def{q, Apply{peg_inc, Tuple{p}}},
    Def{name, ""},
    If{Apply{peg_is_alpha, Tuple{Apply{peg_char_at, Tuple{p}}}}, Do{
        While{Apply{peg_is_alnum, Tuple{Apply{peg_char_at, Tuple{q}}}},
            Set{q, Apply{peg_inc, Tuple{q}}}},
        If{suffix, Do{
            Def{c, Apply{peg_char_at, Tuple{q}}},
            If{If{Apply{expr_eq, Tuple{c, 63}}, true,
                  If{Apply{expr_eq, Tuple{c, 33}},
                      Apply{expr_ne,
                          Tuple{
                              Apply{peg_char_at,
                                  Tuple{Apply{peg_inc, Tuple{q}}}}, 61}},
                      false}},
                Set{q, Apply{peg_inc, Tuple{q}}}, none}}, none},
        Set{name, Apply{str_sub, Tuple{peg_src, p, q}}},
        If{If{Apply{table_get, Tuple{peg_reserved, name, false}}, true,
              If{Apply{expr_eq, Tuple{q, Apply{int_add, Tuple{p, 1}}}},
                 If{Apply{expr_eq, Tuple{Apply{peg_char_at, Tuple{p}}, 102}},
                     Apply{expr_eq,
                         Tuple{Apply{peg_char_at, Tuple{q}}, 34}}, false},
                 false}},
            Apply{peg_fail, Tuple{p}},
            Do{Set{peg_pv, Apply{sym_intern, Tuple{name}}}, q}}},
        Apply{peg_fail, Tuple{p}}}}}}

Def{peg_token_ident, Lambda{Tuple{p}, Apply{peg_scan_ident, Tuple{p, true}}}}
Def{peg_token_rule_name,
    Lambda{Tuple{p}, Apply{peg_scan_ident, Tuple{p, false}}}}

Def{peg_digit_value, Lambda{Tuple{c},
    If{Apply{peg_is_digit, Tuple{c}}, Apply{int_sub, Tuple{c, 48}},
    If{If{Apply{int_le, Tuple{97, c}}, Apply{int_le, Tuple{c, 102}}, false},
        Apply{int_sub, Tuple{c, 87}},
    If{If{Apply{int_le, Tuple{65, c}}, Apply{int_le, Tuple{c, 70}}, false},
        Apply{int_sub, Tuple{c, 55}},
        99}}}}}

" integer: -?[0-9]+, 0x.., 0o.., 0b..; the value is built as a negative number "
"   (as much as -2^30) so that it does not wrap around. "
" A literal that does not fit in 31 bits is Apply{int_parse, Tuple{text}}, "
"   with the text as it is written. "
Def{peg_token_int, Lambda{Tuple{p}, Do{
    Set{p, Apply{peg_skip_ws, Tuple{p}}},
    Def{q, p},
    Def{sign, 1},
    Def{base, 10},
    Def{v, 0},
    Def{d, 0},
    Def{low, -1073741823},
    Def{big, false},
    If{
        If{Apply{expr_eq, Tuple{Apply{peg_char_at, Tuple{q}}, 45}},
            Apply{peg_is_digit,
                Tuple{
                    Apply{peg_char_at,
                        Tuple{Apply{peg_inc, Tuple{q}}}}}}, false},
        Do{Set{sign, -1}, Set{q, Apply{peg_inc, Tuple{q}}}}, none},
    If{Apply{peg_is_digit, Tuple{Apply{peg_char_at, Tuple{q}}}}, Do{
        If{Apply{expr_eq, Tuple{Apply{peg_char_at, Tuple{q}}, 48}}, Do{
            Set{d, Apply{peg_char_at, Tuple{Apply{peg_inc, Tuple{q}}}}},
            If{
                If{Apply{expr_eq, Tuple{d, 120}}, true,
                    Apply{expr_eq, Tuple{d, 88}}}, Set{base, 16},
            If{
                If{Apply{expr_eq, Tuple{d, 111}}, true,
                    Apply{expr_eq, Tuple{d, 79}}}, Set{base, 8},
            If{
                If{Apply{expr_eq, Tuple{d, 98}}, true,
                    Apply{expr_eq, Tuple{d, 66}}}, Set{base, 2}, none}}},
            If{Apply{expr_ne, Tuple{base, 10}},
                Set{q, Apply{int_add, Tuple{q, 2}}}, none}}, none},
        If{Apply{expr_eq, Tuple{sign, -1}}, Set{low, -1073741824}, none},
        Set{d, Apply{peg_digit_value, Tuple{Apply{peg_char_at, Tuple{q}}}}},
        While{Apply{int_lt, Tuple{d, base}}, Do{
            If{
                Apply{int_lt,
                    Tuple{v,
                        Apply{int_div,
                            Tuple{Apply{int_add, Tuple{low, d}}, base}}}},
                Set{big, true},
                Set{v,
                    Apply{int_sub, Tuple{Apply{int_mul, Tuple{v, base}}, d}}}},
            Set{q, Apply{peg_inc, Tuple{q}}},
            Set{d,
                Apply{peg_digit_value, Tuple{Apply{peg_char_at, Tuple{q}}}}}}},
        If{big,
            Set{peg_pv,
                QuasiQuote{
                    Apply{int_parse,
                        Tuple{UnQuote{Apply{str_sub, Tuple{peg_src, p, q}}}}}}},
            Set{peg_pv,
                If{Apply{expr_eq, Tuple{sign, -1}}, v,
                    Apply{int_sub, Tuple{0, v}}}}},
        q},
        Apply{peg_fail, Tuple{p}}}}}}

" float: -?[0-9]+.[0-9]+ and an exponent e or E, an optional -, and [0-9]+ "
"   after it. The tree has the text of the token. "
Def{peg_token_float, Lambda{Tuple{p}, Do{
    Set{p, Apply{peg_skip_ws, Tuple{p}}},
    Def{q, p},
    Def{ok, true},
    Def{r, p},
    If{
        If{Apply{expr_eq, Tuple{Apply{peg_char_at, Tuple{q}}, 45}},
            Apply{peg_is_digit,
                Tuple{
                    Apply{peg_char_at,
                        Tuple{Apply{peg_inc, Tuple{q}}}}}}, false},
        Set{q, Apply{peg_inc, Tuple{q}}}, none},
    If{Apply{peg_is_digit, Tuple{Apply{peg_char_at, Tuple{q}}}}, none,
        Set{ok, false}},
    While{Apply{peg_is_digit, Tuple{Apply{peg_char_at, Tuple{q}}}},
        Set{q, Apply{peg_inc, Tuple{q}}}},
    If{ok,
        If{
            If{Apply{expr_eq, Tuple{Apply{peg_char_at, Tuple{q}}, 46}},
                Apply{peg_is_digit,
                    Tuple{
                        Apply{peg_char_at,
                            Tuple{Apply{peg_inc, Tuple{q}}}}}}, false},
            Set{q, Apply{peg_inc, Tuple{q}}},
            Set{ok, false}},
        none},
    If{ok,
        While{Apply{peg_is_digit, Tuple{Apply{peg_char_at, Tuple{q}}}},
            Set{q, Apply{peg_inc, Tuple{q}}}}, none},
    If{ok,
        If{
            If{Apply{expr_eq, Tuple{Apply{peg_char_at, Tuple{q}}, 101}}, true,
                Apply{expr_eq, Tuple{Apply{peg_char_at, Tuple{q}}, 69}}},
            Do{
                Set{r, Apply{peg_inc, Tuple{q}}},
                If{Apply{expr_eq, Tuple{Apply{peg_char_at, Tuple{r}}, 45}},
                    Set{r, Apply{peg_inc, Tuple{r}}}, none},
                If{Apply{peg_is_digit, Tuple{Apply{peg_char_at, Tuple{r}}}},
                    Do{
                        While{
                            Apply{peg_is_digit,
                                Tuple{Apply{peg_char_at, Tuple{r}}}},
                            Set{r, Apply{peg_inc, Tuple{r}}}},
                        Set{q, r}},
                    Set{ok, false}}},
            none},
        none},
    If{ok,
        Do{Set{peg_pv, Apply{str_sub, Tuple{peg_src, p, q}}}, q},
        Apply{peg_fail, Tuple{p}}}}}}

Def{peg_escapes, Apply{table_new, Tuple{}}}
Apply{table_set, Tuple{peg_escapes, 48, "\0"}}
Apply{table_set, Tuple{peg_escapes, 97, "\a"}}
Apply{table_set, Tuple{peg_escapes, 98, "\b"}}
Apply{table_set, Tuple{peg_escapes, 116, "\t"}}
Apply{table_set, Tuple{peg_escapes, 110, "\n"}}
Apply{table_set, Tuple{peg_escapes, 118, "\v"}}
Apply{table_set, Tuple{peg_escapes, 102, "\f"}}
Apply{table_set, Tuple{peg_escapes, 114, "\r"}}
Apply{table_set, Tuple{peg_escapes, 34, "\""}}
Apply{table_set, Tuple{peg_escapes, 39, "'"}}
Apply{table_set, Tuple{peg_escapes, 92, "\\"}}

" string: \"...\" with the peg_escapes above, in one line "
Def{peg_token_string, Lambda{Tuple{p}, Do{
    Set{p, Apply{peg_skip_ws, Tuple{p}}},
    Def{q, Apply{peg_inc, Tuple{p}}},
    Def{start, q},
    Def{acc, ""},
    Def{c, Apply{peg_char_at, Tuple{q}}},
    Def{e, none},
    If{Apply{expr_ne, Tuple{Apply{peg_char_at, Tuple{p}}, 34}},
        Apply{peg_fail, Tuple{p}}, Do{
        While{
            If{Apply{expr_ne, Tuple{c, 34}},
                If{Apply{expr_ne, Tuple{c, 10}}, Apply{int_ge, Tuple{c, 0}},
                    false}, false}, Do{
            If{Apply{expr_eq, Tuple{c, 92}}, Do{
                Set{e,
                    Apply{table_get,
                        Tuple{peg_escapes,
                            Apply{peg_char_at, Tuple{Apply{peg_inc, Tuple{q}}}},
                            none}}},
                If{Apply{expr_eq, Tuple{e, none}},
                    Do{Set{c, -1}, Set{q, Apply{peg_fail, Tuple{q}}}}, Do{
                    Set{acc,
                        Apply{str_cat,
                            Tuple{acc,
                                Apply{str_sub, Tuple{peg_src, start, q}}}}},
                    Set{acc, Apply{str_cat, Tuple{acc, e}}},
                    Set{q, Apply{int_add, Tuple{q, 2}}},
                    Set{start, q}}}},
                Set{q, Apply{peg_inc, Tuple{q}}}},
            If{Apply{int_ge, Tuple{c, 0}}, Set{c, Apply{peg_char_at, Tuple{q}}},
                none}}},
        If{Apply{expr_eq, Tuple{c, 34}},
            Do{
                Set{peg_pv,
                    Apply{str_cat,
                        Tuple{acc, Apply{str_sub, Tuple{peg_src, start, q}}}}},
                Apply{peg_inc, Tuple{q}}},
            Apply{peg_fail, Tuple{q}}}}}}}}

" 'word in a grammar: Key{\"word\"} "
Def{peg_token_keyword, Lambda{Tuple{p}, Do{
    Set{p, Apply{peg_skip_ws, Tuple{p}}},
    Def{q, Apply{peg_inc, Tuple{p}}},
    If{
        If{Apply{expr_eq, Tuple{Apply{peg_char_at, Tuple{p}}, 39}},
            Apply{peg_is_alpha, Tuple{Apply{peg_char_at, Tuple{q}}}},
            false}, Do{
        While{Apply{peg_is_alnum, Tuple{Apply{peg_char_at, Tuple{q}}}},
            Set{q, Apply{peg_inc, Tuple{q}}}},
        Set{peg_pv,
            Key{Apply{str_sub, Tuple{peg_src, Apply{peg_inc, Tuple{p}}, q}}}},
        q},
        Apply{peg_fail, Tuple{p}}}}}}

" character class: [set] or [^set]. The blanks at both ends of the set are not "
"   in it. "
Def{peg_token_class, Lambda{Tuple{p}, Do{
    Set{p, Apply{peg_skip_ws, Tuple{p}}},
    Def{q, p},
    Def{neg, false},
    Def{start, 0},
    Def{endp, 0},
    Def{spec, ""},
    Def{c, 0},
    Def{go, true},
    If{Apply{expr_ne, Tuple{Apply{peg_char_at, Tuple{p}}, 91}},
        Apply{peg_fail, Tuple{p}}, Do{
        Set{q, Apply{peg_inc, Tuple{p}}},
        If{Apply{expr_eq, Tuple{Apply{peg_char_at, Tuple{q}}, 94}},
            Do{Set{neg, true}, Set{q, Apply{peg_inc, Tuple{q}}}}, none},
        While{Apply{peg_is_blank, Tuple{Apply{peg_char_at, Tuple{q}}}},
            Set{q, Apply{peg_inc, Tuple{q}}}},
        Set{start, q},
        Set{endp, q},
        While{go, Do{
            Set{c, Apply{peg_char_at, Tuple{q}}},
            If{Apply{int_lt, Tuple{c, 0}}, Set{go, false},
            If{Apply{expr_eq, Tuple{c, 93}}, Set{go, false},
            If{Apply{expr_eq, Tuple{c, 92}},
                If{
                    Apply{int_lt,
                        Tuple{
                            Apply{peg_char_at, Tuple{Apply{peg_inc, Tuple{q}}}},
                            0}}, Set{go, false}, Do{
                    Set{q, Apply{int_add, Tuple{q, 2}}},
                    Set{endp, q}}},
            If{Apply{peg_is_blank, Tuple{c}},
                Set{q, Apply{peg_inc, Tuple{q}}}, Do{
                Set{q, Apply{peg_inc, Tuple{q}}},
                Set{endp, q}}}}}}}},
        Set{spec, Apply{str_sub, Tuple{peg_src, start, endp}}},
        If{
            If{Apply{expr_eq, Tuple{Apply{peg_char_at, Tuple{q}}, 93}},
                Apply{int_gt, Tuple{endp, start}}, false},
            If{Apply{expr_eq, Tuple{Apply{peg_charset, Tuple{spec}}, none}},
                Apply{peg_fail, Tuple{p}}, Do{
                Set{peg_pv,
                    Apply{expr,
                        Tuple{If{neg, Quote{NoneOf}, Quote{OneOf}},
                            Tuple{spec}}}},
                Apply{peg_inc, Tuple{q}}}},
            Apply{peg_fail, Tuple{p}}}}}}}}

Apply{_define_rule, Tuple{Quote{ident}, peg_token_ident}}
Apply{_define_rule, Tuple{Quote{rule_name}, peg_token_rule_name}}
Apply{_define_rule, Tuple{Quote{integer}, peg_token_int}}
Apply{_define_rule, Tuple{Quote{float}, peg_token_float}}
Apply{_define_rule, Tuple{Quote{string}, peg_token_string}}
Apply{_define_rule, Tuple{Quote{keyword}, peg_token_keyword}}
Apply{_define_rule, Tuple{Quote{charclass}, peg_token_class}}
Apply{_define_rule, Tuple{Quote{here}, peg_token_here}}

" === Actions === "

Def{peg_first, Lambda{Tuple{t}, Apply{arg, Tuple{t, 0}}}}

" the tree t without the At of the calls in it, except in the parts !e: an "
"   f(a, ...) in a quote is a tree to be matched or built, not a call "
Def{peg_unat, none}
Set{peg_unat, Lambda{Tuple{t},
    If{Apply{expr_ne, Tuple{Apply{expr_type, Tuple{t}}, Expr}}, t,
    If{
        If{Apply{expr_eq, Tuple{Apply{head, Tuple{t}}, Quote{At}}},
            Apply{expr_eq, Tuple{Apply{arity, Tuple{t}}, 2}}, false},
        Apply{peg_unat, Tuple{Apply{arg, Tuple{t, 1}}}},
    If{Apply{expr_eq, Tuple{Apply{head, Tuple{t}}, Quote{UnQuote}}}, t,
        Apply{peg_map_args, Tuple{peg_unat, t}}}}}}}

" Tuple{a, b, c} -> Cons{a, Cons{b, Cons{c, Nil{}}}} "
Def{peg_to_list, Lambda{Tuple{t}, Do{
    Def{i, Apply{arity, Tuple{t}}},
    Def{r, Quote{Nil{}}},
    While{Apply{int_gt, Tuple{i, 0}}, Do{
        Set{i, Apply{int_sub, Tuple{i, 1}}},
        Set{r,
            QuasiQuote{Cons{UnQuote{Apply{arg, Tuple{t, i}}}, UnQuote{r}}}}}},
    r}}}

" === Functions of the syntax sugar === "

" The functions peg_* and the rules of the syntax sugar. They come before the "
"   grammar since the actions of its rules call them. "

" the decimal text of an integer "

Def{peg_itoa, none}
Set{peg_itoa,
    Lambda{
        Tuple{n},
        If{
            Apply{int_lt, Tuple{n, 0}},
            Apply{str_cat,
                Tuple{"-",
                    Apply{peg_itoa, Tuple{Apply{int_sub, Tuple{0, n}}}}}},
            If{
                Apply{int_lt, Tuple{n, 10}},
                Apply{str_sub,
                    Tuple{"0123456789", n, Apply{int_add, Tuple{n, 1}}}},
                Apply{
                    str_cat,
                    Tuple{
                        Apply{peg_itoa, Tuple{Apply{int_div, Tuple{n, 10}}}},
                        Apply{peg_itoa, Tuple{Apply{int_mod, Tuple{n, 10}}}}
                    }
                }
            }
        }
    }}

" a function that matches no arguments: what follows p if c -> e when no | "
"   follows it "

Def{peg_no_type, Quote{nomatch}}

Def{_nomatch, Lambda{Tuple{_TypeOf{_, peg_no_type}}, none}}

Def{peg_g, Apply{sym_intern, Tuple{"%g"}}}

" the head of a pattern p or q before peg_pats takes it away: %or{p, q} "

Def{peg_or, Apply{sym_intern, Tuple{"%or"}}}

" def_run is declared with ::= at the end of the file. Until then it matches "
"   nothing. "

Apply{_define_rule,
    Tuple{Quote{def_run}, Lambda{Tuple{p}, Apply{peg_fail, Tuple{p}}}}}

Def{peg_ret_handler, QuasiQuote{Lambda{Tuple{Return{v}, k}, v}}}

Def{peg_break_handler, QuasiQuote{Lambda{Tuple{Break{}, k}, none}}}

Def{peg_continue_handler, QuasiQuote{Lambda{Tuple{Continue{}, k}, none}}}

Def{
    peg_catches,
    Lambda{
        Tuple{h, tag},
        If{
            Apply{peg_is_head, Tuple{h, Quote{Lambda}}},
            If{
                Apply{int_gt,
                    Tuple{Apply{arity, Tuple{Apply{arg, Tuple{h, 0}}}}, 0}},
                Apply{peg_is_head,
                    Tuple{Apply{arg, Tuple{Apply{arg, Tuple{h, 0}}, 0}}, tag}},
                false
            },
            false
        }
    }}

Def{peg_scan, none}
Set{peg_scan,
    Lambda{
        Tuple{e, tag},
        Do{
            If{
                Apply{expr_ne, Tuple{Apply{expr_type, Tuple{e}}, Expr}},
                false,
                Do{
                    Def{h, Apply{head, Tuple{e}}},
                    If{
                        If{Apply{expr_eq, Tuple{h, Quote{Quote}}}, true,
                            Apply{expr_eq, Tuple{h, Quote{QuasiQuote}}}},
                        false,
                        If{
                            If{
                                Apply{expr_eq, Tuple{h, Quote{Perform}}},
                                If{
                                    Apply{expr_eq,
                                        Tuple{Apply{arity, Tuple{e}}, 1}},
                                    Apply{peg_is_head,
                                        Tuple{Apply{arg, Tuple{e, 0}}, tag}},
                                    false
                                },
                                false
                            },
                            true,
                            If{
                                If{
                                    Apply{expr_eq, Tuple{h, Quote{Handle}}},
                                    If{
                                        Apply{expr_eq,
                                            Tuple{Apply{arity, Tuple{e}}, 2}},
                                        Apply{peg_catches,
                                            Tuple{
                                                Apply{arg, Tuple{e, 1}}, tag}},
                                        false
                                    },
                                    false
                                },
                                Apply{peg_scan,
                                    Tuple{Apply{arg, Tuple{e, 1}}, tag}},
                                Do{
                                    Def{i, 0},
                                    Def{r, false},
                                    While{
                                        If{
                                            Apply{_not, Tuple{r}},
                                            Apply{int_lt,
                                                Tuple{i,
                                                    Apply{arity, Tuple{e}}}},
                                            false
                                        },
                                        Do{
                                            Set{r,
                                                Apply{peg_scan,
                                                    Tuple{
                                                        Apply{arg,
                                                            Tuple{e,
                                                                i}}, tag}}},
                                            Set{i, Apply{int_add, Tuple{i, 1}}}
                                        }
                                    },
                                    r
                                }
                            }
                        }
                    }
                }
            }
        }
    }}

Def{peg_nret, 0}

Def{peg_nbrk, 0}

Def{peg_ncnt, 0}

Def{peg_parse_plain, peg_parse_from}

Set{
    peg_parse_from,
    Lambda{
        Tuple{r, s, pos, loc},
        Do{Set{peg_nret, 0}, Set{peg_nbrk, 0}, Set{peg_ncnt, 0},
            Apply{peg_parse_plain, Tuple{r, s, pos, loc}}}
    }}

Def{
    peg_wrap,
    Lambda{
        Tuple{body, tag, handler},
        If{Apply{peg_scan, Tuple{body, tag}},
            QuasiQuote{Handle{UnQuote{body}, UnQuote{handler}}}, body}
    }}

Def{
    peg_lambda,
    Lambda{
        Tuple{ps, body},
        QuasiQuote{
            Lambda{
                UnQuote{ps},
                UnQuote{
                    If{
                        Apply{int_gt, Tuple{peg_nret, 0}},
                        Apply{peg_wrap,
                            Tuple{body, Quote{Return}, peg_ret_handler}},
                        body
                    }
                }
            }
        }
    }}

" Tuple{%v1, ..., %vn} "

Def{
    peg_vars,
    Lambda{
        Tuple{n},
        Do{
            Def{vs, Tuple{}},
            Def{i, 1},
            While{
                Apply{int_le, Tuple{i, n}},
                Do{
                    Set{vs,
                        Apply{array_push,
                            Tuple{vs,
                                Apply{sym_intern,
                                    Tuple{
                                        Apply{str_cat,
                                            Tuple{"%v",
                                                Apply{peg_itoa,
                                                    Tuple{i}}}}}}}}},
                    Set{i, Apply{int_add, Tuple{i, 1}}}
                }
            },
            vs
        }
    }}

" (p, ...) if c -> e. The function takes the arguments as %v1, ... and calls "
"   %g with them "
" when the parameters do not match or c is false. %g is _nomatch until "
"   peg_fuse puts a function there. "

" the parameters ps end with a rest parameter x... "
Def{
    peg_has_rest,
    Lambda{
        Tuple{ps},
        If{
            Apply{int_gt, Tuple{Apply{arity, Tuple{ps}}, 0}},
            Do{
                Def{l,
                    Apply{arg,
                        Tuple{ps,
                            Apply{int_sub,
                                Tuple{Apply{arity, Tuple{ps}}, 1}}}}},
                If{
                    Apply{expr_eq, Tuple{Apply{expr_type, Tuple{l}}, Expr}},
                    Apply{expr_eq, Tuple{Apply{head, Tuple{l}}, Quote{_Rest}}},
                    false
                }
            },
            false
        }
    }}

" A function with a guard calls the functions after it with all of its "
"   arguments again, so it has no rest parameter: "
" the tree _Rest{ps} that it gives is an error when it is compiled. "
Def{
    peg_guard,
    Lambda{
        Tuple{ps, c, e},
        If{Apply{peg_has_rest, Tuple{ps}}, QuasiQuote{_Rest{UnQuote{ps}}},
        Do{
            Def{vs, Apply{peg_vars, Tuple{Apply{arity, Tuple{ps}}}}},
            Def{f,
                Apply{peg_lambda,
                    Tuple{ps,
                        QuasiQuote{
                            If{UnQuote{c}, UnQuote{e},
                                Apply{UnQuote{peg_g}, UnQuote{vs}}}}}}},
            QuasiQuote{
                Apply{
                    Lambda{
                        Tuple{UnQuote{peg_g}},
                        Fusion{
                            Lambda{UnQuote{vs},
                                Apply{Fusion{UnQuote{f}, UnQuote{peg_g}},
                                    UnQuote{vs}}},
                            UnQuote{peg_g}
                        }
                    },
                    Tuple{_nomatch}
                }
            }
        }}
    }}

" f | g: g goes in the place of the last _nomatch of the functions with a "
"   guard in f "

Def{peg_fuse, none}
Set{peg_fuse,
    Fusion{
        Lambda{
            Tuple{Quote{_nomatch}, g},
            g
        },
        Fusion{
            Lambda{
                Tuple{
                    Apply{
                        Lambda{Tuple{k},
                            Fusion{Lambda{vs, Apply{Fusion{a, k2}, vs2}}, k3}},
                        Tuple{r}}, g},
                If{
                    Apply{expr_eq, Tuple{k, peg_g}},
                    QuasiQuote{
                        Apply{
                            Lambda{Tuple{UnQuote{k}},
                                Fusion{
                                    Lambda{UnQuote{vs},
                                        Apply{Fusion{UnQuote{a}, UnQuote{k2}},
                                            UnQuote{vs2}}}, UnQuote{k3}}},
                            Tuple{UnQuote{Apply{peg_fuse, Tuple{r, g}}}}
                        }
                    },
                    QuasiQuote{
                        Fusion{
                            Apply{
                                Lambda{Tuple{UnQuote{k}},
                                    Fusion{
                                        Lambda{UnQuote{vs},
                                            Apply{
                                                Fusion{UnQuote{a}, UnQuote{k2}},
                                                UnQuote{vs2}}}, UnQuote{k3}}},
                                Tuple{UnQuote{r}}
                            },
                            UnQuote{g}
                        }
                    }
                }
            },
            Fusion{
                Lambda{
                    Tuple{Fusion{a, b}, g},
                    QuasiQuote{
                        Fusion{UnQuote{a},
                            UnQuote{Apply{peg_fuse, Tuple{b, g}}}}}
                },
                Lambda{Tuple{f, g}, QuasiQuote{Fusion{UnQuote{f}, UnQuote{g}}}}
            }
        }
    }}

" t[f]: when a function in f has a guard, (_ -> '%skip) goes last with "
"   peg_fuse, "
" so that a part that no function applies to gives peg_skip and subst goes "
"   into its arguments "

Def{peg_skip, Apply{sym_intern, Tuple{"%skip"}}}

Def{peg_guarded, none}
Set{peg_guarded,
    Fusion{
        Lambda{Tuple{Fusion{_, g}}, Apply{peg_guarded, Tuple{g}}},
        Fusion{
            Lambda{
                Tuple{
                    Apply{
                        Lambda{Tuple{k},
                            Fusion{Lambda{_, Apply{Fusion{_, _}, _}}, _}},
                        Tuple{_}}},
                Apply{expr_eq, Tuple{k, peg_g}}
            },
            Lambda{Tuple{_}, false}
        }
    }}

Def{
    _peg_rewrite,
    Lambda{
        Tuple{e},
        If{
            Apply{peg_guarded, Tuple{e}},
            Apply{peg_fuse,
                Tuple{e,
                    QuasiQuote{Lambda{Tuple{_}, Quote{UnQuote{peg_skip}}}}}},
            e
        }
    }}

" the body without the handler of return that peg_lambda put around it "

Def{
    peg_unret,
    Lambda{
        Tuple{b},
        If{
            If{
                Apply{peg_is_head, Tuple{b, Quote{Handle}}},
                If{
                    Apply{expr_eq, Tuple{Apply{arity, Tuple{b}}, 2}},
                    If{
                        Apply{expr_eq,
                            Tuple{Apply{arg, Tuple{b, 1}}, peg_ret_handler}},
                        Apply{peg_scan,
                            Tuple{Apply{arg, Tuple{b, 0}}, Quote{Return}}},
                        false
                    },
                    false
                },
                false
            },
            Apply{arg, Tuple{b, 0}},
            b
        }
    }}

" the functions joined by | in match, with the handlers of return taken off "
"   their bodies, "
" so that a return in an arm belongs to the function around the match "

Def{peg_arms, none}
Set{peg_arms,
    Fusion{
        Lambda{
            Tuple{Fusion{f, g}},
            QuasiQuote{
                Fusion{UnQuote{Apply{peg_arms, Tuple{f}}},
                    UnQuote{Apply{peg_arms, Tuple{g}}}}}
        },
        Fusion{
            Lambda{Tuple{Lambda{ps, b}},
                QuasiQuote{
                    Lambda{UnQuote{ps}, UnQuote{Apply{peg_unret, Tuple{b}}}}}},
            Fusion{
                Lambda{
                    Tuple{
                        Apply{
                            Lambda{Tuple{k},
                                Fusion{Lambda{vs, Apply{Fusion{f, k2}, vs2}},
                                    k3}}, Tuple{g}}},
                    If{
                        If{
                            Apply{expr_eq, Tuple{k, peg_g}},
                            If{Apply{expr_eq, Tuple{k2, k}},
                                If{Apply{expr_eq, Tuple{k3, k}},
                                    Apply{expr_eq, Tuple{vs2, vs}},
                                    false}, false},
                            false
                        },
                        QuasiQuote{
                            Apply{
                                Lambda{
                                    Tuple{UnQuote{k}},
                                    Fusion{
                                        Lambda{
                                            UnQuote{vs},
                                            Apply{
                                                Fusion{
                                                    UnQuote{
                                                        Apply{peg_arms,
                                                            Tuple{f}}},
                                                    UnQuote{k}}, UnQuote{vs}}
                                        },
                                        UnQuote{k}
                                    }
                                },
                                Tuple{UnQuote{Apply{peg_arms, Tuple{g}}}}
                            }
                        },
                        QuasiQuote{
                            Apply{
                                Lambda{Tuple{UnQuote{k}},
                                    Fusion{
                                        Lambda{UnQuote{vs},
                                            Apply{
                                                Fusion{UnQuote{f}, UnQuote{k2}},
                                                UnQuote{vs2}}}, UnQuote{k3}}},
                                Tuple{UnQuote{g}}}}
                    }
                },
                Lambda{Tuple{f}, f}
            }
        }
    }}

" match s { f } is f applied to s "

Def{
    peg_match,
    Lambda{Tuple{s, f},
        QuasiQuote{
            Apply{UnQuote{Apply{peg_arms, Tuple{f}}}, Tuple{UnQuote{s}}}}}}

" show(x) is defined in lib/pretty.pk (show(x) = ...); f\"{x}\" calls it for a "
"   value that is not a string or an integer "

Def{show, none}

Def{
    _to_text,
    Lambda{
        Tuple{x},
        Apply{
            Fusion{
                Lambda{Tuple{_TypeOf{s, String}}, s},
                Fusion{
                    Lambda{Tuple{_TypeOf{n, Int}}, Apply{peg_itoa, Tuple{n}}},
                    Lambda{Tuple{_}, Apply{show, Tuple{x}}}
                }
            },
            Tuple{x}
        }
    }}

Def{
    peg_token_istr_open,
    Lambda{
        Tuple{p},
        Do{
            Set{p, Apply{peg_skip_ws, Tuple{p}}},
            If{
                If{
                    Apply{expr_eq, Tuple{Apply{peg_char_at, Tuple{p}}, 102}},
                    Apply{expr_eq,
                        Tuple{
                            Apply{peg_char_at,
                                Tuple{Apply{int_add, Tuple{p, 1}}}}, 34}},
                    false
                },
                Do{Set{peg_pv, none}, Apply{int_add, Tuple{p, 2}}},
                Apply{peg_fail, Tuple{p}}
            }
        }
    }}

Def{
    peg_token_istr_text,
    Lambda{
        Tuple{p},
        Do{
            Def{q, p},
            Def{start, p},
            Def{acc, ""},
            Def{ok, true},
            Def{go, true},
            Def{c, Apply{peg_char_at, Tuple{q}}},
            While{
                go,
                Do{
                    If{
                        If{
                            Apply{expr_eq, Tuple{c, 34}},
                            true,
                            If{Apply{int_lt, Tuple{c, 0}}, true,
                                Apply{expr_eq, Tuple{c, 10}}}
                        },
                        Set{go, false},
                        If{
                            Apply{expr_eq, Tuple{c, 123}},
                            Do{
                                If{
                                    Apply{expr_eq,
                                        Tuple{
                                            Apply{peg_char_at,
                                                Tuple{
                                                    Apply{int_add,
                                                        Tuple{q, 1}}}}, 123}},
                                    Do{
                                        Set{
                                            acc,
                                            Apply{
                                                str_cat,
                                                Tuple{
                                                    Apply{
                                                        str_cat,
                                                        Tuple{acc,
                                                            Apply{str_sub,
                                                                Tuple{peg_src,
                                                                    start, q}}}
                                                    },
                                                    "{"
                                                }
                                            }
                                        },
                                        Set{q, Apply{int_add, Tuple{q, 2}}},
                                        Set{start, q},
                                        Set{c, Apply{peg_char_at, Tuple{q}}}
                                    },
                                    Set{go, false}
                                }
                            },
                            If{
                                Apply{expr_eq, Tuple{c, 125}},
                                Do{
                                    If{
                                        Apply{
                                            expr_eq,
                                            Tuple{
                                                Apply{peg_char_at,
                                                    Tuple{
                                                        Apply{int_add,
                                                            Tuple{q, 1}}}}, 125}
                                        },
                                        Do{
                                            Set{
                                                acc,
                                                Apply{
                                                    str_cat,
                                                    Tuple{
                                                        Apply{
                                                            str_cat,
                                                            Tuple{
                                                                acc,
                                                                Apply{str_sub,
                                                                    Tuple{
                                                                        peg_src,
                                                                        start,
                                                                        q}}
                                                            }
                                                        },
                                                        "}"
                                                    }
                                                }
                                            },
                                            Set{q, Apply{int_add, Tuple{q, 2}}},
                                            Set{start, q},
                                            Set{c, Apply{peg_char_at, Tuple{q}}}
                                        },
                                        Do{Set{ok, false}, Set{go, false}}
                                    }
                                },
                                If{
                                    Apply{expr_eq, Tuple{c, 92}},
                                    Do{
                                        Def{
                                            e,
                                            Apply{
                                                table_get,
                                                Tuple{
                                                    peg_escapes,
                                                    Apply{peg_char_at,
                                                        Tuple{
                                                            Apply{int_add,
                                                                Tuple{q, 1}}}},
                                                    none
                                                }
                                            }
                                        },
                                        If{
                                            Apply{expr_eq, Tuple{e, none}},
                                            Do{Set{ok, false}, Set{go, false}},
                                            Do{
                                                Set{
                                                    acc,
                                                    Apply{
                                                        str_cat,
                                                        Tuple{
                                                            Apply{
                                                                str_cat,
                                                                Tuple{
                                                                    acc,
                                                                    Apply{str_sub, Tuple{peg_src, start, q}}
                                                                }
                                                            },
                                                            e
                                                        }
                                                    }
                                                },
                                                Set{q,
                                                    Apply{int_add,
                                                        Tuple{q, 2}}},
                                                Set{start, q},
                                                Set{c,
                                                    Apply{peg_char_at,
                                                        Tuple{q}}}
                                            }
                                        }
                                    },
                                    Do{Set{q, Apply{int_add, Tuple{q, 1}}},
                                        Set{c, Apply{peg_char_at, Tuple{q}}}}
                                }
                            }
                        }
                    }
                }
            },
            If{
                ok,
                Do{
                    Set{peg_pv,
                        Apply{str_cat,
                            Tuple{acc,
                                Apply{str_sub, Tuple{peg_src, start, q}}}}}, q},
                Apply{peg_fail, Tuple{q}}
            }
        }
    }}

Def{peg_token_istr_hole, none}
Set{peg_token_istr_hole,
    Lambda{
        Tuple{p},
        If{
            Apply{expr_eq, Tuple{Apply{peg_char_at, Tuple{p}}, 123}},
            Do{Set{peg_pv, "{"}, Apply{int_add, Tuple{p, 1}}},
            Apply{peg_fail, Tuple{p}}
        }
    }}

Def{
    peg_token_istr_close,
    Lambda{
        Tuple{p},
        If{
            Apply{expr_eq, Tuple{Apply{peg_char_at, Tuple{p}}, 34}},
            Do{Set{peg_pv, "\""}, Apply{int_add, Tuple{p, 1}}},
            Apply{peg_fail, Tuple{p}}
        }
    }}

Def{
    peg_interp,
    Lambda{
        Tuple{parts, last},
        Do{
            Def{acc, none},
            Def{
                seg,
                Lambda{
                    Tuple{x},
                    Set{
                        acc,
                        If{
                            Apply{expr_eq, Tuple{acc, none}},
                            x,
                            QuasiQuote{
                                Apply{str_cat, Tuple{UnQuote{acc}, UnQuote{x}}}}
                        }
                    }
                }
            },
            Def{i, 0},
            While{
                Apply{int_lt, Tuple{i, Apply{arity, Tuple{parts}}}},
                Do{
                    Def{t, Apply{arg, Tuple{Apply{arg, Tuple{parts, i}}, 0}}},
                    If{Apply{expr_ne, Tuple{t, ""}},
                        Apply{seg, Tuple{t}}, none},
                    Apply{
                        seg,
                        Tuple{
                            QuasiQuote{
                                Apply{
                                    _to_text,
                                    Tuple{
                                        UnQuote{
                                            Apply{arg,
                                                Tuple{
                                                    Apply{arg,
                                                        Tuple{parts, i}}, 2}}}}
                                }
                            }
                        }
                    },
                    Set{i, Apply{int_add, Tuple{i, 1}}}
                }
            },
            If{Apply{expr_ne, Tuple{last, ""}}, Apply{seg, Tuple{last}}, none},
            If{Apply{expr_eq, Tuple{acc, none}}, "", acc}
        }
    }}

Apply{_define_rule, Tuple{Quote{istr_open}, peg_token_istr_open}}

Apply{_define_rule, Tuple{Quote{istr_text}, peg_token_istr_text}}

Apply{_define_rule, Tuple{Quote{istr_hole}, peg_token_istr_hole}}

Apply{_define_rule, Tuple{Quote{istr_close}, peg_token_istr_close}}

" the field names of each type that record declares: type -> Tuple of the "
"   names "
Def{record_fields, Apply{table_new, Tuple{}}}

" _record(name, fields) is Tuple{type, make} of a new type: expr_record, and "
"   the field names are kept for t.f "
Def{
    _record,
    Lambda{
        Tuple{name, fields},
        Do{
            Def{r, Apply{expr_record, Tuple{name, fields}}},
            Apply{table_set,
                Tuple{record_fields, Apply{arg, Tuple{r, 0}}, fields}},
            r
        }
    }}

" the index of the field name of the data t of a type that record declares, or "
"   none "
Def{
    _record_index,
    Lambda{
        Tuple{t, name},
        Do{
            Def{fs,
                Apply{table_get,
                    Tuple{record_fields, Apply{expr_type, Tuple{t}}, none}}},
            Def{i, 0},
            Def{r, none},
            If{
                Apply{expr_ne, Tuple{fs, none}},
                While{
                    Apply{int_lt, Tuple{i, Apply{arity, Tuple{fs}}}},
                    Do{
                        If{
                            Apply{expr_eq,
                                Tuple{Apply{arg, Tuple{fs, i}}, name}},
                            Do{Set{r, i}, Set{i, Apply{arity, Tuple{fs}}}},
                            Set{i, Apply{int_add, Tuple{i, 1}}}}
                    }
                },
                none
            },
            r
        }
    }}

" a module value is a Module, whose field is the table that holds the names "
"   and the values of the fields of this value "
Def{_module_type, Apply{_record, Tuple{Quote{Module}, Quote{Tuple{table}}}}}

Def{Module, Apply{arg, Tuple{_module_type, 0}}}

Def{_make_module, Apply{arg, Tuple{_module_type, 1}}}

Def{
    _module,
    Lambda{
        Tuple{names, values},
        Do{
            Def{t, Apply{table_new, Tuple{}}},
            While{
                Apply{expr_eq, Tuple{Apply{head, Tuple{names}}, Quote{Cons}}},
                Do{
                    Apply{table_set,
                        Tuple{t, Apply{arg, Tuple{names, 0}},
                            Apply{arg, Tuple{values, 0}}}},
                    Set{names, Apply{arg, Tuple{names, 1}}},
                    Set{values, Apply{arg, Tuple{values, 1}}}
                }
            },
            Apply{_make_module, Tuple{t}}
        }
    }}

Def{
    _record_get,
    Fusion{
        Lambda{
            Tuple{_TypeOf{m, Module}, name},
            Do{
                Def{a, Apply{arg, Tuple{Apply{arg, Tuple{m, 0}}, 0}}},
                Def{e,
                    Apply{table_find,
                        Tuple{a, name, Apply{expr_hash, Tuple{name}}}}},
                If{
                    Apply{expr_eq, Tuple{e, none}},
                    Do{
                        Apply{print,
                            Tuple{
                                Apply{str_cat,
                                    Tuple{"no field ",
                                        Apply{str_cat,
                                            Tuple{Apply{sym_name, Tuple{name}},
                                                " in Module{}"}}}}}},
                        Apply{os_exit, Tuple{1}}
                    },
                    none
                },
                Apply{array_get, Tuple{e, 1}}
            }
        },
        Lambda{
            Tuple{t, name},
            Do{
                Def{i, Apply{_record_index, Tuple{t, name}}},
                If{
                    Apply{expr_eq, Tuple{i, none}},
                    Do{
                        Apply{os_put, Tuple{"no field "}},
                        Apply{print,
                            Tuple{Apply{sym_name, Tuple{name}},
                                _Kw{Quote{end}, ""}}},
                        Apply{os_put, Tuple{" in "}},
                        Apply{print, Tuple{t, _Kw{Quote{end}, ""}}},
                        Apply{os_put, Tuple{"\n"}},
                        Apply{os_exit, Tuple{1}}
                    },
                    none
                },
                Apply{arg, Tuple{t, i}}
            }
        }}}

Def{peg_module, none}
Def{peg_macro, none}
Def{peg_import, none}

Def{peg_with, none}

Def{peg_names, none}

Def{peg_destruct, none}

Def{peg_compound, none}

Def{peg_index_update, none}

Def{peg_fresh_count, 0}

" _testing is true while the tests in the test blocks of modules run "
"   (tools/test.pk) "
Def{_testing, false}

Def{peg_record, none}


Def{
    peg_loop,
    Lambda{
        Tuple{loop},
        If{Apply{int_gt, Tuple{peg_nbrk, 0}},
            Apply{peg_wrap, Tuple{loop, Quote{Break}, peg_break_handler}}, loop}
    }}

Def{
    peg_body,
    Lambda{
        Tuple{b},
        If{Apply{int_gt, Tuple{peg_ncnt, 0}},
            Apply{peg_wrap, Tuple{b, Quote{Continue}, peg_continue_handler}}, b}
    }}

Def{
    peg_while,
    Lambda{
        Tuple{c, b},
        Apply{peg_loop,
            Tuple{
                QuasiQuote{
                    While{UnQuote{c}, UnQuote{Apply{peg_body, Tuple{b}}}}}}}
    }}

Def{
    peg_for_tree,
    Lambda{
        Tuple{x, xs, b},
        Apply{
            peg_loop,
            Tuple{
                QuasiQuote{
                    Apply{
                        peg_for,
                        Tuple{UnQuote{xs},
                            Lambda{Tuple{UnQuote{x}},
                                UnQuote{Apply{peg_body, Tuple{b}}}}}
                    }
                }
            }
        }
    }}

Def{
    peg_return,
    Lambda{
        Tuple{v},
        Do{
            Set{peg_nret, Apply{int_add, Tuple{peg_nret, 1}}},
            If{
                Apply{expr_eq, Tuple{Apply{arity, Tuple{v}}, 0}},
                QuasiQuote{Perform{Return{none}}},
                QuasiQuote{
                    Perform{
                        Return{
                            UnQuote{
                                Apply{arg,
                                    Tuple{Apply{arg, Tuple{v, 0}}, 1}}}}}}
            }
        }
    }}

Def{
    peg_break,
    Lambda{Tuple{},
        Do{Set{peg_nbrk, Apply{int_add, Tuple{peg_nbrk, 1}}},
            QuasiQuote{Perform{Break{}}}}}}

Def{
    peg_continue,
    Lambda{Tuple{},
        Do{Set{peg_ncnt, Apply{int_add, Tuple{peg_ncnt, 1}}},
            QuasiQuote{Perform{Continue{}}}}}}

" the expressions of a block "
Def{
    peg_block,
    Lambda{
        Tuple{es},
        Apply{expr,
            Tuple{Quote{Do}, Apply{peg_map_args, Tuple{peg_first, es}}}}}}

" === a[i], a[i] = v and t[p -> e | ...] === "

Def{
    _index_error,
    Lambda{
        Tuple{a, i},
        Do{
            Apply{os_put, Tuple{"index out of range: "}},
            Apply{print, Tuple{i, _Kw{Quote{end}, ""}}},
            Apply{os_put, Tuple{" in "}},
            Apply{print, Tuple{a, _Kw{Quote{end}, ""}}},
            Apply{os_put, Tuple{"\n"}},
            Apply{os_exit, Tuple{1}}
        }
    }}

Def{
    _index_check,
    Lambda{
        Tuple{a, i, n},
        If{
            If{Apply{int_lt, Tuple{i, 0}}, true, Apply{int_ge, Tuple{i, n}}},
            Apply{_index_error, Tuple{a, i}},
            none
        }
    }}

" subst(t, f) replaces the parts of t that f applies to. Each part is tried "
"   from the root down: "
" when a pattern of f matches it, it is replaced by the value of f and its "
"   parts are not tried; "
" otherwise its arguments are tried, and the head is kept. "
Def{
    subst,
    Lambda{
        Tuple{t, f},
        Do{
            Def{go, none},
            Def{g, Fusion{f, Lambda{Tuple{_}, peg_skip}}},
            Set{
                go,
                Lambda{
                    Tuple{x},
                    Do{
                        Def{y, Apply{g, Tuple{x}}},
                        If{
                            Apply{expr_ne, Tuple{y, peg_skip}},
                            y,
                            If{
                                Apply{expr_eq,
                                    Tuple{Apply{expr_type, Tuple{x}}, Expr}},
                                Do{
                                    Def{r,
                                        Apply{expr,
                                            Tuple{Apply{head, Tuple{x}},
                                                Tuple{}}}},
                                    Def{i, 0},
                                    While{
                                        Apply{int_lt,
                                            Tuple{i, Apply{arity, Tuple{x}}}},
                                        Do{
                                            Set{
                                                r,
                                                Apply{
                                                    array_push,
                                                    Tuple{
                                                        r,
                                                        Apply{go,
                                                            Tuple{
                                                                Apply{arg,
                                                                    Tuple{
                                                                        x, i}}}}
                                                    }
                                                }
                                            },
                                            Set{i, Apply{int_add, Tuple{i, 1}}}
                                        }
                                    },
                                    r
                                },
                                x
                            }
                        }
                    }
                }
            },
            Apply{go, Tuple{t}}
        }
    }}

Def{
    _list_get,
    Lambda{
        Tuple{xs, i},
        Do{
            Def{ys, xs},
            Def{n, i},
            While{
                If{
                    Apply{int_gt, Tuple{n, 0}},
                    Apply{expr_eq, Tuple{Apply{head, Tuple{ys}}, Quote{Cons}}},
                    false
                },
                Do{Set{ys, Apply{arg, Tuple{ys, 1}}},
                    Set{n, Apply{int_sub, Tuple{n, 1}}}}
            },
            If{
                If{
                    Apply{int_lt, Tuple{i, 0}},
                    true,
                    Apply{expr_ne, Tuple{Apply{head, Tuple{ys}}, Quote{Cons}}}
                },
                Apply{_index_error, Tuple{xs, i}},
                none
            },
            Apply{arg, Tuple{ys, 0}}
        }
    }}

" a[i] is _index_get(a, i), a function for each kind of a joined by Fusion. A "
"   program adds its own kind in front: "
" _index_get = (Matrix{w, _, d}, (i, j)) -> d[i * w + j] | _index_get "
Def{
    _index_get,
    Fusion{
        Lambda{Tuple{_TypeOf{a, Array}, _TypeOf{i, Int}},
            Apply{array_get, Tuple{a, i}}},
        Fusion{
            Lambda{
                Tuple{_TypeOf{s, String}, _TypeOf{i, Int}},
                Do{
                    Apply{_index_check, Tuple{s, i, Apply{str_len, Tuple{s}}}},
                    Apply{str_sub, Tuple{s, i, Apply{int_add, Tuple{i, 1}}}}
                }
            },
            Fusion{
                Lambda{Tuple{_TypeOf{t, Table}, k},
                    Apply{table_get, Tuple{t, k, none}}},
                Fusion{
                    Lambda{Tuple{x, _TypeOf{f, Function}},
                        Apply{subst, Tuple{x, f}}},
                    Fusion{
                        Lambda{
                            Tuple{Cons{x, xs}, _TypeOf{i, Int}},
                            Apply{_list_get, Tuple{Cons{x, xs}, i}}
                        },
                        Fusion{
                            Lambda{
                                Tuple{Nil{}, _TypeOf{i, Int}},
                                Apply{_index_error, Tuple{Nil{}, i}}
                            },
                            Fusion{
                                    Lambda{
                                        Tuple{_TypeOf{t, Expr},
                                            _TypeOf{i, Int}},
                                        Do{
                                            Apply{_index_check,
                                                Tuple{t, i,
                                                    Apply{arity, Tuple{t}}}},
                                            Apply{arg, Tuple{t, i}}
                                        }
                                    },
                                    Lambda{
                                        Tuple{a, i},
                                        Do{
                                            Apply{os_put,
                                                Tuple{"no index for "}},
                                            Apply{print,
                                                Tuple{a, _Kw{Quote{end}, ""}}},
                                            Apply{os_put, Tuple{" and "}},
                                            Apply{print,
                                                Tuple{i, _Kw{Quote{end}, ""}}},
                                            Apply{os_put, Tuple{"\n"}},
                                            Apply{os_exit, Tuple{1}}
                                        }
                                    }
                            }
                        }
                    }
                }
            }
        }
    }}

" a plain array (plain_u8, plain_u16, plain_i32) is indexed like an array "
Set{
    _index_get,
    Fusion{
        Lambda{
            Tuple{_TypeOf{a, Plain}, _TypeOf{i, Int}},
            Apply{plain_get, Tuple{a, i}}
        },
        _index_get
    }}

" a[i] = v is _index_set(a, i, v) "
Def{
    _index_set_immutable,
    Lambda{
        Tuple{kind, a, i},
        Do{
            Apply{os_put, Tuple{"cannot assign to an element of "}},
            Apply{print, Tuple{kind, _Kw{Quote{end}, ""}}},
            Apply{os_put, Tuple{", which is immutable: "}},
            Apply{print, Tuple{a, _Kw{Quote{end}, ""}}},
            Apply{os_put, Tuple{" at "}},
            Apply{print, Tuple{i, _Kw{Quote{end}, ""}}},
            Apply{os_put, Tuple{"\n"}},
            Apply{os_exit, Tuple{1}}
        }
    }}

Def{
    _index_set,
    Fusion{
        Lambda{Tuple{_TypeOf{a, Array}, _TypeOf{i, Int}, v},
            Apply{array_set, Tuple{a, i, v}}},
        Fusion{
            Lambda{Tuple{_TypeOf{t, Table}, k, v},
                Apply{table_set, Tuple{t, k, v}}},
            Fusion{
                Lambda{
                    Tuple{_TypeOf{s, String}, i, v},
                    Apply{_index_set_immutable, Tuple{"a string", s, i}}
                },
                Fusion{
                    Lambda{
                        Tuple{Cons{x, xs}, i, v},
                        Apply{_index_set_immutable,
                            Tuple{"a list", Cons{x, xs}, i}}
                    },
                    Fusion{
                        Lambda{
                            Tuple{Nil{}, i, v},
                            Apply{_index_set_immutable,
                                Tuple{"a list", Nil{}, i}}
                        },
                        Fusion{
                            Lambda{
                                Tuple{_TypeOf{t, Expr}, i, v},
                                Apply{
                                    _index_set_immutable,
                                    Tuple{
                                        If{
                                            Apply{expr_eq,
                                                Tuple{Apply{head, Tuple{t}},
                                                    Quote{Tuple}}},
                                            "a tuple",
                                            "an M-expression"
                                        },
                                        t,
                                        i
                                    }
                                }
                            },
                            Lambda{
                                Tuple{a, i, v},
                                Do{
                                    Apply{os_put,
                                        Tuple{"no index assignment for "}},
                                    Apply{print, Tuple{a, _Kw{Quote{end}, ""}}},
                                    Apply{os_put, Tuple{" and "}},
                                    Apply{print, Tuple{i, _Kw{Quote{end}, ""}}},
                                    Apply{os_put, Tuple{"\n"}},
                                    Apply{os_exit, Tuple{1}}
                                }
                            }
                        }
                    }
                }
            }
        }
    }}

Set{
    _index_set,
    Fusion{
        Lambda{
            Tuple{_TypeOf{a, Plain}, _TypeOf{i, Int}, v},
            Apply{plain_set, Tuple{a, i, v}}
        },
        _index_set
    }}

" === Embedded text of a rule === "
" name{| text |} reads the text by the rule name when the expression is "
"   parsed. "
" The rule decides where the text ends, and |} must follow it. "
" The value is the value of the rule as a constant. "

Def{peg_token_embed, Lambda{Tuple{p}, Do{
    Set{p, Apply{peg_skip_ws, Tuple{p}}},
    Def{q, p},
    Def{r, none},
    Def{v, none},
    If{Apply{peg_is_alpha, Tuple{Apply{peg_char_at, Tuple{p}}}}, Do{
        While{Apply{peg_is_alnum, Tuple{Apply{peg_char_at, Tuple{q}}}},
            Set{q, Apply{peg_inc, Tuple{q}}}},
        If{
            If{Apply{expr_eq, Tuple{Apply{peg_char_at, Tuple{q}}, 123}},
                Apply{expr_eq,
                    Tuple{Apply{peg_char_at, Tuple{Apply{peg_inc, Tuple{q}}}},
                        124}}, false}, Do{
            Set{r,
                Apply{sym_intern, Tuple{Apply{str_sub, Tuple{peg_src, p, q}}}}},
            If{
                Apply{expr_eq,
                    Tuple{Apply{table_get, Tuple{peg_ids, r, none}}, none}},
                Apply{peg_fail, Tuple{p}}, Do{
                Set{q,
                    Apply{peg_call_rule,
                        Tuple{r, Apply{int_add, Tuple{q, 2}}}}},
                If{Apply{int_lt, Tuple{q, 0}}, -1, Do{
                    Set{v, peg_pv},
                    Set{q,
                        Apply{peg_literal,
                            Tuple{"|}", Apply{peg_skip_ws, Tuple{q}}}}},
                    If{Apply{int_lt, Tuple{q, 0}}, -1, Do{
                        Set{peg_pv, Apply{expr, Tuple{Quote{Quote}, Tuple{v}}}},
                        q}}}}}}},
            Apply{peg_fail, Tuple{p}}}},
        Apply{peg_fail, Tuple{p}}}}}}

Apply{_define_rule, Tuple{Quote{embed}, peg_token_embed}}

" -> or the word if after the blanks at p, which are not consumed "
Def{peg_token_arrow_next, Lambda{Tuple{p}, Do{
    Def{q, Apply{peg_skip_ws, Tuple{p}}},
    Def{c, Apply{peg_char_at, Tuple{q}}},
    Def{d, Apply{peg_char_at, Tuple{Apply{int_add, Tuple{q, 1}}}}},
    Set{peg_pv, none},
    If{If{Apply{expr_eq, Tuple{c, 45}}, Apply{expr_eq, Tuple{d, 62}}, false}, p,
    If{
        If{Apply{expr_eq, Tuple{c, 105}},
            If{Apply{expr_eq, Tuple{d, 102}},
                Apply{_not,
                    Tuple{
                        Apply{peg_is_alnum,
                            Tuple{
                                Apply{peg_char_at,
                                    Tuple{Apply{int_add, Tuple{q, 2}}}}}}}},
                false}, false}, p,
        Apply{peg_fail, Tuple{p}}}}}}}

Apply{_define_rule, Tuple{Quote{arrow_next}, peg_token_arrow_next}}

" === Grammar of the grammar === "
" A rule is declared with  name ::= alt | alt ...  An alternative is items and "
"   an optional action { ... }. "
" This part defines the declarations with m-exprs, in the form that the "
"   declarations make themselves, "
" and the expressions that an action is written with. After the switch below, "
"   the rest of the file is read "
" by these rules, and the rules of planck are declared with ::=. "

" the functions that the actions of the declarations call "
Def{peg_choice, Lambda{Tuple{es},
    If{Apply{expr_eq, Tuple{Apply{arity, Tuple{es}}, 1}},
        Apply{peg_first, Tuple{es}},
        Apply{expr, Tuple{Quote{Choice}, es}}}}}

" (e) is e, and (e, ...) is the tuple of them "
Def{peg_group, Lambda{Tuple{es},
    If{Apply{expr_eq, Tuple{Apply{arity, Tuple{es}}, 1}},
        Apply{peg_first, Tuple{es}}, es}}}

" if (c) a, or if (c) a else b when b is Tuple{Tuple{else, b}} (the value of "
"   the option) "
Def{peg_if, Lambda{Tuple{c, a, b},
    If{Apply{expr_eq, Tuple{b, Tuple{}}},
        QuasiQuote{If{UnQuote{c}, UnQuote{a}, none}},
        QuasiQuote{
            If{UnQuote{c}, UnQuote{a},
                UnQuote{Apply{arg, Tuple{Apply{arg, Tuple{b, 0}}, 1}}}}}}}}

" the items and the action of an alternative: Act{Seq{items...}, "
"   Lambda{Tuple{Tuple{labels...}}, action}} "
Def{peg_alt, Lambda{Tuple{items, act}, Do{
    Def{labels, Apply{peg_map_args, Tuple{peg_first, items}}},
    Def{elems,
        Apply{peg_map_args,
            Tuple{Lambda{Tuple{t}, Apply{arg, Tuple{t, 1}}}, items}}},
    Def{seq, Apply{expr, Tuple{Quote{Seq}, elems}}},
    If{Apply{expr_eq, Tuple{act, Tuple{}}},
        If{Apply{expr_eq, Tuple{Apply{arity, Tuple{elems}}, 1}},
            Apply{peg_first, Tuple{elems}}, seq},
        QuasiQuote{Act{UnQuote{seq},
            Lambda{Tuple{UnQuote{labels}},
                UnQuote{
                    Apply{arg, Tuple{Apply{peg_first, Tuple{act}}, 1}}}}}}}}}}

Apply{_define_rule, Tuple{Quote{same}, Quote{Same{}}}}

Apply{_define_rule, Tuple{Quote{syntax_decl}, Quote{
    Act{Seq{rule_name, "::=", g_choice},
        Lambda{Tuple{Tuple{n, _, e}},
            Do{
                QuasiQuote{
                    Apply{_define_rule,
                        Tuple{Quote{UnQuote{n}}, Quote{UnQuote{e}}}}}}}}}}}

Apply{_define_rule, Tuple{Quote{g_choice}, Quote{
    Act{Seq{Delimited1{g_alt, "|"}},
        Lambda{Tuple{Tuple{es}}, Do{Apply{peg_choice, Tuple{es}}}}}}}}

Apply{_define_rule, Tuple{Quote{g_alt}, Quote{Choice{
    Act{Seq{"..."}, Lambda{Tuple{Tuple{_}}, Do{Quote{Prev{}}}}},
    Act{Seq{Many1{g_item}, Option{Seq{same, block}}},
        Lambda{Tuple{Tuple{items, act}},
            Do{Apply{peg_alt, Tuple{items, act}}}}}}}}}

Apply{_define_rule, Tuple{Quote{g_item}, Quote{Choice{
    Act{Seq{same, ident, Tight{":"}, g_suffix},
        Lambda{Tuple{Tuple{_, l, _, e}}, Do{Tuple{l, e}}}},
    Act{Seq{same, g_suffix},
        Lambda{Tuple{Tuple{_, e}}, Do{Tuple{Quote{_}, e}}}}}}}}

Apply{_define_rule, Tuple{Quote{g_suffix}, Quote{Choice{
    Act{Seq{g_primary, Tight{"*"}},
        Lambda{Tuple{Tuple{e, _}}, Do{QuasiQuote{Many{UnQuote{e}}}}}},
    Act{Seq{g_primary, Tight{"+"}},
        Lambda{Tuple{Tuple{e, _}}, Do{QuasiQuote{Many1{UnQuote{e}}}}}},
    Act{Seq{g_primary, Tight{"?"}},
        Lambda{Tuple{Tuple{e, _}}, Do{QuasiQuote{Option{UnQuote{e}}}}}},
    Act{Seq{"&", g_primary},
        Lambda{Tuple{Tuple{_, e}}, Do{QuasiQuote{And{UnQuote{e}}}}}},
    Act{Seq{"!", g_primary},
        Lambda{Tuple{Tuple{_, e}}, Do{QuasiQuote{Not{UnQuote{e}}}}}},
    g_primary}}}}

Apply{_define_rule, Tuple{Quote{g_primary}, Quote{Choice{
    string,
    keyword,
    charclass,
    Act{Seq{".", Not{Tight{"."}}},
        Lambda{Tuple{Tuple{_, _}}, Do{Quote{Any{}}}}},
    Act{Seq{Key{"nospace"}, Tight{"("}, string, ")"},
        Lambda{Tuple{Tuple{_, _, s, _}}, Do{QuasiQuote{Tight{UnQuote{s}}}}}},
    Act{Seq{Key{"delimited"}, Tight{"("}, g_choice, ",", g_choice, ")"},
        Lambda{Tuple{Tuple{_, _, e, _, s, _}},
            Do{QuasiQuote{Delimited{UnQuote{e}, UnQuote{s}}}}}},
    Act{Seq{Key{"delimited1"}, Tight{"("}, g_choice, ",", g_choice, ")"},
        Lambda{Tuple{Tuple{_, _, e, _, s, _}},
            Do{QuasiQuote{Delimited1{UnQuote{e}, UnQuote{s}}}}}},
    Act{Seq{rule_name, Not{Choice{"::=", Tight{":"}}}},
        Lambda{Tuple{Tuple{n, _}}, Do{n}}},
    Act{Seq{"(", g_choice, ")"}, Lambda{Tuple{Tuple{_, e, _}}, Do{e}}}}}}}

" === The expressions of an action === "
" The smallest syntax that the actions below need: M-expressions, calls, `e, "
"   'e and !e, and blocks. "
" Rules of the same names are declared again with ::= after they are read. "

Apply{_define_rule, Tuple{Quote{toplevel}, Quote{
    Act{Seq{expr, Choice{";", Not{same}, And{expr}}}, peg_first}}}}

Apply{_define_rule, Tuple{Quote{expr}, Quote{Choice{syntax_decl, unary}}}}

Apply{_define_rule, Tuple{Quote{unary}, Quote{Choice{
    postfix,
    Act{Seq{"'", unary},
        Lambda{Tuple{Tuple{_, a}}, Apply{expr, Tuple{Quote{Quote}, Tuple{a}}}}},
    Act{Seq{"`", unary},
        Lambda{Tuple{Tuple{_, a}},
            Apply{expr, Tuple{Quote{QuasiQuote}, Tuple{a}}}}},
    Act{Seq{"!", unary},
        Lambda{Tuple{Tuple{_, a}},
            Apply{expr, Tuple{Quote{UnQuote}, Tuple{a}}}}}}}}}

Apply{_define_rule, Tuple{Quote{postfix}, Quote{Choice{
    Act{Seq{postfix, Tight{"("}, Delimited{expr, ","}, ")"},
        Lambda{Tuple{Tuple{f, _, args, _}},
            QuasiQuote{Apply{UnQuote{f}, UnQuote{args}}}}},
    primary}}}}

Apply{_define_rule, Tuple{Quote{primary}, Quote{Choice{
    block,
    Act{Seq{ident, Tight{"{"}, Delimited{expr, ","}, "}"},
        Lambda{Tuple{Tuple{h, _, args, _}}, Apply{expr, Tuple{h, args}}}},
    ident,
    integer,
    string}}}}

Apply{_define_rule, Tuple{Quote{block}, Quote{
    Act{Seq{"{", Many{Seq{expr, Option{";"}}}, "}"},
        Lambda{Tuple{Tuple{_, es, _}}, Apply{peg_block, Tuple{es}}}}}}}

" === Switch to the grammar read by the rules above === "
" The rest of the file is read by them. The M-expression reader remains as "
"   parse_mexpr. "
Def{parse_mexpr, parse}
Set{parse_from,
    Lambda{Tuple{s, pos},
        Apply{peg_parse_from, Tuple{Quote{toplevel}, s, pos, none}}}}
Set{parse, Lambda{Tuple{s}, Apply{peg_parse, Tuple{Quote{toplevel}, s}}}}
Def{parse_at,
    Lambda{Tuple{s, loc}, Apply{peg_parse_at, Tuple{Quote{toplevel}, s, loc}}}}

" === The grammar of the grammar, declared with ::= === "
" The rules above declare themselves again, in the form that they make. "
" A rule declared again replaces the rule that read this text. "

syntax_decl ::= n:rule_name "::=" e:g_choice { `Apply{_define_rule, Tuple{Quote{!n}, Quote{!e}}} }

g_choice ::= es:delimited1(g_alt, "|") { peg_choice(es) }

g_alt ::= "..." { 'Prev{} }
        | items:g_item+ act:(same block)? { peg_alt(items, act) }

g_item ::= same l:ident nospace(":") e:g_suffix { Tuple{l, e} }
         | same e:g_suffix { Tuple{'_, e} }

g_suffix ::= e:g_primary nospace("*") { `Many{!e} }
           | e:g_primary nospace("+") { `Many1{!e} }
           | e:g_primary nospace("?") { `Option{!e} }
           | "&" e:g_primary { `And{!e} }
           | "!" e:g_primary { `Not{!e} }
           | g_primary

g_primary ::= string
            | keyword
            | charclass
            | "." !nospace(".") { 'Any{} }
            | 'nospace nospace("(") s:string ")" { `Tight{!s} }
            | 'delimited nospace("(") e:g_choice "," s:g_choice ")" { `Delimited{!e, !s} }
            | 'delimited1 nospace("(") e:g_choice "," s:g_choice ")" { `Delimited1{!e, !s} }
            | n:rule_name !("::=" | nospace(":")) { n }
            | "(" e:g_choice ")" { e }

" === The rules of planck === "
" From the tightest binding to the loosest, so that each rule refers to rules "
"   already declared: "
" the rest of the file is read by the rules declared so far. The actions are "
"   written in the expressions "
" that the rules above allow: M-expressions, calls and quasi-quotes. "

" a binary - must be on the same line as its left operand "
minus ::= same "-" !nospace(">")

" the = of an assignment, not == "
assign_op ::= "=" !nospace("=")
            | compound_op

" the operator of x += e: the function that the operator calls "
compound_op ::= "+=" { 'int_add }
              | "-=" { 'int_sub }
              | "*=" { 'int_mul }
              | "/=" { 'int_div }
              | "%=" { 'int_mod }

" the inside of a[...]: an expression. In t[p -> e | q if c -> g] the "
"   functions joined by | "
" end with a function that gives peg_skip (_peg_rewrite) "
index ::= e:expr { _peg_rewrite(e) }

unary ::= postfix
        | "-" a:unary { `int_sub(0, !a) }
        | "+" a:unary { a }
        | "'" a:unary { expr('Quote, Tuple{peg_unat(a)}) }
        | "`" a:unary { expr('QuasiQuote, Tuple{peg_unat(a)}) }
        | "!" a:unary { expr('UnQuote, Tuple{a}) }

" the type after @: a name, or a field of a module (a.B) "
type_ref ::= m:type_ref nospace(".") f:ident { `Apply{_record_get, Tuple{!m, Quote{!f}}} }
           | ident

" f(x, a = d1, b = d2) := e is f(x, _kwrest...) := { _kwcheck(_kwrest, "
"   Tuple{a, b}); a := _kwarg(_kwrest, 0, 'a, () -> d1); b := ...; e }. "
" peg_defaults(ps, e) is Tuple{parameters, body}. The parameters without a "
"   default are not changed. "
Def{
    peg_is_default,
    Lambda{
        Tuple{x},
        If{Apply{expr_eq, Tuple{Apply{expr_type, Tuple{x}}, Expr}},
            Apply{expr_eq, Tuple{Apply{head, Tuple{x}}, Quote{_Default}}},
            false}}}

Def{
    peg_defaults,
    Lambda{
        Tuple{ps, e},
        Do{
            Def{n, Apply{arity, Tuple{ps}}},
            Def{k, 0},
            While{
                If{Apply{int_lt, Tuple{k, n}},
                    Apply{_not,
                        Tuple{
                            Apply{peg_is_default,
                                Tuple{Apply{arg, Tuple{ps, k}}}}}}, false},
                Set{k, Apply{int_add, Tuple{k, 1}}}},
            If{
                Apply{expr_eq, Tuple{k, n}},
                Tuple{ps, e},
                Do{
                    Def{plain, Tuple{}},
                    Def{i, 0},
                    While{
                        Apply{int_lt, Tuple{i, k}},
                        Do{
                            Set{plain,
                                Apply{array_push,
                                    Tuple{plain, Apply{arg, Tuple{ps, i}}}}},
                            Set{i, Apply{int_add, Tuple{i, 1}}}}},
                    Def{names, Tuple{}},
                    Def{items, Tuple{}},
                    While{
                        Apply{int_lt, Tuple{i, n}},
                        Do{
                            Def{d, Apply{arg, Tuple{ps, i}}},
                            Def{name, Apply{arg, Tuple{d, 0}}},
                            Def{idx, Apply{int_sub, Tuple{i, k}}},
                            Set{names, Apply{array_push, Tuple{names, name}}},
                            Set{items, Apply{array_push, Tuple{items, QuasiQuote{Def{UnQuote{name}, Apply{_kwarg, Tuple{_kwrest, UnQuote{idx}, Quote{UnQuote{name}}, Lambda{Tuple{}, UnQuote{Apply{arg, Tuple{d, 1}}}}}}}}}}},
                            Set{i, Apply{int_add, Tuple{i, 1}}}}},
                    Def{all,
                        Apply{array_push,
                            Tuple{Tuple{},
                                QuasiQuote{
                                    Apply{_kwcheck,
                                        Tuple{_kwrest,
                                            Quote{UnQuote{names}}}}}}}},
                    Set{i, 0},
                    While{
                        Apply{int_lt, Tuple{i, Apply{arity, Tuple{items}}}},
                        Do{
                            Set{all,
                                Apply{array_push,
                                    Tuple{all, Apply{arg, Tuple{items, i}}}}},
                            Set{i, Apply{int_add, Tuple{i, 1}}}}},
                    Set{all, Apply{array_push, Tuple{all, e}}},
                    Tuple{
                        Apply{array_push, Tuple{plain, Quote{_Rest{_kwrest}}}},
                        Apply{expr, Tuple{Quote{Do}, all}}}}}}}}

" a lambda with the parameters of a definition, which may have defaults "
Def{
    peg_lambda_defaults,
    Lambda{
        Tuple{ps, e},
        Do{
            Def{r, Apply{peg_defaults, Tuple{ps, e}}},
            Apply{peg_lambda,
                Tuple{Apply{arg, Tuple{r, 0}}, Apply{arg, Tuple{r, 1}}}}}}}

" peg_items(x, xs) is the Tuple of x and the second elements of the elements "
"   of xs "
Def{
    peg_items,
    Lambda{
        Tuple{x, xs},
        Do{
            Def{r, Apply{array_push, Tuple{Tuple{}, x}}},
            Def{i, 0},
            While{
                Apply{int_lt, Tuple{i, Apply{arity, Tuple{xs}}}},
                Do{
                    Set{r,
                        Apply{array_push,
                            Tuple{r,
                                Apply{arg,
                                    Tuple{Apply{arg, Tuple{xs, i}}, 1}}}}},
                    Set{i, Apply{int_add, Tuple{i, 1}}}
                }
            },
            r
        }}}

" peg_tuple_cat(a, b) is the Tuple of the elements of a and then those of b "
Def{
    peg_tuple_cat,
    Lambda{
        Tuple{a, b},
        Do{
            Def{r, a},
            Def{i, 0},
            While{
                Apply{int_lt, Tuple{i, Apply{arity, Tuple{b}}}},
                Do{
                    Set{r,
                        Apply{array_push, Tuple{r, Apply{arg, Tuple{b, i}}}}},
                    Set{i, Apply{int_add, Tuple{i, 1}}}
                }
            },
            r
        }}}

" An argument is an expression or name = expression (_Kw{'name, e}). The ones "
"   with names come after the ones without. "
" An expression of an argument is not an assignment: x = e at the start of an "
"   argument is the name x. "
call_kw ::= n:ident "=" !nospace("=") e:expr { `_Kw{Quote{!n}, !e} }
call_pos ::= !(ident "=" !nospace("=")) e:expr { e }
call_list ::= x:call_pos xs:("," call_pos)* { peg_items(x, xs) }
kw_list ::= x:call_kw xs:("," call_kw)* { peg_items(x, xs) }
" the arguments as they are written: the check of the order is the lookahead "
"   of call_args in postfix "
call_arg ::= call_kw | call_pos
call_args ::= a:call_list "," k:kw_list { peg_tuple_cat(a, k) }
            | kw_list
            | delimited(call_pos, ",")

postfix ::= l:here f:postfix nospace("(") &(call_args ")") args:delimited(call_arg, ",") ")" { peg_at(l, `Apply{!f, !args}) }
          | x:postfix "@" t:type_ref { `_TypeOf{!x, !t} }
          | t:postfix nospace(".") f:ident { `Apply{_record_get, Tuple{!t, Quote{!f}}} }
          | a:postfix nospace("[") i:index "]" !assign_op { `Apply{_index_get, Tuple{!a, !i}} }
          | x:ident "..." { `_Rest{!x} }
          | primary

mul_expr ::= a:mul_expr "*" b:unary { `int_mul(!a, !b) }
           | a:mul_expr "//" b:unary { `int_quo(!a, !b) }
           | a:mul_expr "/" b:unary { `int_div(!a, !b) }
           | a:mul_expr "%" b:unary { `int_mod(!a, !b) }
           | unary

add_expr ::= a:add_expr "+" b:mul_expr { `int_add(!a, !b) }
           | a:add_expr minus b:mul_expr { `int_sub(!a, !b) }
           | mul_expr

" a..b is Range{a, b}, the integers from a to b including b. Its operands are "
"   add_expr. "
range_expr ::= a:add_expr ".." b:add_expr { `Range{!a, !b} }
             | add_expr

" x :: xs is Cons{x, xs}. It groups to the right. "
cons_expr ::= a:add_expr "::" b:cons_expr { `Cons{!a, !b} }
            | range_expr

rel_expr ::= a:cons_expr "==" b:cons_expr { `expr_eq(!a, !b) }
           | a:cons_expr "!=" b:cons_expr { `expr_ne(!a, !b) }
           | a:cons_expr "<=" b:cons_expr { `int_le(!a, !b) }
           | a:cons_expr ">=" b:cons_expr { `int_ge(!a, !b) }
           | a:cons_expr "<" b:cons_expr { `int_lt(!a, !b) }
           | a:cons_expr ">" b:cons_expr { `int_gt(!a, !b) }
           | cons_expr

not_expr ::= 'not a:not_expr { `_not(!a) }
           | rel_expr

and_expr ::= a:not_expr 'and b:and_expr { `If{!a, !b, false} }
           | not_expr

or_expr ::= a:and_expr 'or b:or_expr { `If{!a, true, !b} }
          | and_expr

" === Patterns === "
" A pattern is written as an expression up to or, and matches the tree of that "
"   expression: "
" a + b is Apply{'int_add, Tuple{a, b}} and f(x) is Apply{'f, Tuple{x}}. "
" The names of operators and functions are symbols, the other identifiers are "
"   variables. "
" (f)(p, ...) is Apply{f, Tuple{p, ...}} with the variable f: a call of any "
"   function. "
" p @ type is _TypeOf{p, type}, and the arguments of Head{p, ...} are "
"   patterns. "
" p or q matches what p or q matches (peg_pats). A name written twice matches "
"   two values that are ==. "

pat_primary ::= f:ident nospace("(") args:delimited(pattern, ",") ")" { `Apply{Quote{!f}, !args} }
              | h:ident nospace("{") args:delimited(pattern, ",") "}" { expr(h, args) }
              | "(" f:ident ")" nospace("(") args:delimited(pattern, ",") ")" { `Apply{!f, !args} }
              | ident
              | integer
              | string
              | "(" ")" { 'Tuple{} }
              | "(" ps:delimited1(pattern, ",") ")" { peg_group(ps) }
              | "[" ps:delimited(pattern, ",") "]" { peg_to_list(ps) }

pat_postfix ::= x:pat_postfix "@" t:type_ref { `_TypeOf{!x, !t} }
              | x:ident "..." { `_Rest{!x} }
              | pat_primary

" 'e is the value of the expression e "
pat_unary ::= pat_postfix
            | "-" a:pat_unary { `Apply{'int_sub, Tuple{0, !a}} }
            | "'" a:unary { expr('Quote, Tuple{a}) }

pat_mul ::= a:pat_mul "*" b:pat_unary { `Apply{'int_mul, Tuple{!a, !b}} }
          | a:pat_mul "//" b:pat_unary { `Apply{'int_quo, Tuple{!a, !b}} }
          | a:pat_mul "/" b:pat_unary { `Apply{'int_div, Tuple{!a, !b}} }
          | a:pat_mul "%" b:pat_unary { `Apply{'int_mod, Tuple{!a, !b}} }
          | pat_unary

pat_add ::= a:pat_add "+" b:pat_mul { `Apply{'int_add, Tuple{!a, !b}} }
          | a:pat_add minus b:pat_mul { `Apply{'int_sub, Tuple{!a, !b}} }
          | pat_mul

pat_cons ::= a:pat_add "::" b:pat_cons { `Cons{!a, !b} }
           | pat_add

pat_rel ::= a:pat_cons "==" b:pat_cons { `Apply{'expr_eq, Tuple{!a, !b}} }
          | a:pat_cons "!=" b:pat_cons { `Apply{'expr_ne, Tuple{!a, !b}} }
          | a:pat_cons "<=" b:pat_cons { `Apply{'int_le, Tuple{!a, !b}} }
          | a:pat_cons ">=" b:pat_cons { `Apply{'int_ge, Tuple{!a, !b}} }
          | a:pat_cons "<" b:pat_cons { `Apply{'int_lt, Tuple{!a, !b}} }
          | a:pat_cons ">" b:pat_cons { `Apply{'int_gt, Tuple{!a, !b}} }
          | pat_cons

pat_not ::= 'not a:pat_not { `Apply{'_not, Tuple{!a}} }
          | pat_rel

pat_and ::= a:pat_not 'and b:pat_and { `If{!a, !b, 'false} }
          | pat_not

pattern ::= a:pat_and 'or b:pattern { expr(peg_or, Tuple{a, b}) }
          | pat_and

" === Functions, assignments and the other forms === "

" the parameters are read as patterns only when an expression and -> or if "
"   follow, "
" since every text of a pattern is also a text of an expression. The rule "
"   keeps the result for the position. "
params ::= "(" ps:delimited(pattern, ",") ")" &arrow_next { ps }
         | p:pattern { Tuple{p} }

lambda_ahead ::= &(or_expr arrow_next)

" params if c -> e is a function with the guard c (peg_guard) "
arrow ::= lambda_ahead ps:params "->" e:arrow { peg_lambda(ps, e) }
        | lambda_ahead ps:params 'if c:or_expr "->" e:arrow { peg_guard(ps, c, e) }
        | or_expr

" the fields of e with { f = v, ... } "
with_field ::= f:ident "=" !nospace("=") e:expr { Tuple{f, e} }

" a record value with some fields replaced; with can follow with "
with_expr ::= o:with_expr 'with "{" fs:delimited1(with_field, ",") "}" { peg_with(o, fs) }
            | postfix

" the names of (a, b, ...) := e and (a, b, ...) = e: two or more "
destruct_names ::= "(" a:ident "," bs:delimited1(ident, ",") ")" { Tuple{a, bs} }

" the left side of x := e and x = e: a name, or !x which is replaced by the "
"   name inside a quasi-quote "
target ::= ident
         | "!" x:ident { expr('UnQuote, Tuple{x}) }

" The parameters of a definition: the ones with a pattern, and then the ones "
"   with a default value name = expression (_Default{name, e}). "
def_default ::= n:ident "=" !nospace("=") e:expr { `_Default{!n, !e} }
def_plain ::= !(ident "=" !nospace("=")) p:pattern { p }
def_plain_list ::= x:def_plain xs:("," def_plain)* { peg_items(x, xs) }
def_default_list ::= x:def_default xs:("," def_default)* { peg_items(x, xs) }
def_param ::= def_default | pattern
def_params ::= a:def_plain_list "," d:def_default_list { peg_tuple_cat(a, d) }
             | def_default_list
             | delimited(pattern, ",")

" a branch of if: an expression without | outside of brackets, "
" so that a | after if (c) a else b goes on with the functions around the if "
branch ::= &(postfix ":=") f:ident nospace("(") &(def_params ")") ps:delimited(def_param, ",") ")" ":=" e:branch {
               `DefFun{!f, !peg_lambda_defaults(ps, e)}
           }
         | ns:destruct_names ":=" e:branch { peg_destruct('Def, ns, e) }
         | ns:destruct_names "=" !nospace("=") e:branch { peg_destruct('Set, ns, e) }
         | x:ident op:compound_op e:branch { peg_compound(x, op, e) }
         | a:postfix nospace("[") i:expr "]" op:compound_op v:branch { peg_index_update(a, i, op, v) }
         | x:target ":=" e:branch { `Def{!x, !e} }
         | &(postfix "=" !nospace("=")) f:ident nospace("(") ps:delimited(pattern, ",") ")" "=" !nospace("=") e:branch {
               `Set{!f, Fusion{!f, !peg_lambda(ps, e)}}
           }
         | x:target "=" !nospace("=") e:branch { `Set{!x, !e} }
         | arrow

" the condition is in parentheses, the branches are branch. "
" else belongs to the nearest if, since the branch takes it first. "
if_expr ::= 'if "(" c:expr ")" a:branch b:('else branch)? { peg_if(c, a, b) }

" a function with a guard passes its arguments on to the functions after its | "
" when the guard is false (peg_fuse) "
union ::= f:arrow "|" g:union { peg_fuse(f, g) }
        | arrow

sugar_primary ::= 'match s:or_expr "{" f:union "}" { peg_match(s, f) }
                | 'return v:(same arrow)? { peg_return(v) }
                | 'break { peg_break() }
                | 'continue { peg_continue() }
                | 'for "(" x:pattern 'in xs:expr ")" b:expr { peg_for_tree(x, xs, b) }

block ::= "{" es:(expr ";"?)* "}" { peg_block(es) }

primary ::= if_expr
          | 'while "(" c:expr ")" b:expr { peg_while(c, b) }
          | 'handle b:expr 'with h:union { `Handle{!b, !h} }
          | 'perform v:unary { `Perform{!v} }
          | block
          | embed
          | h:ident nospace("{") args:delimited(expr, ",") "}" { expr(h, args) }
          | istr_open parts:(istr_text istr_hole expr "}")* last:istr_text istr_close { peg_interp(parts, last) }
          | ident
          | t:float { `Apply{float_parse, Tuple{!t}} }
          | integer
          | string
          | "(" ")" { 'Tuple{} }
          | "(" es:delimited1(expr, ",") ")" { peg_group(es) }
          | "[" es:delimited(expr, ",") "]" { peg_to_list(es) }
          | sugar_primary

idents ::= delimited(ident, ",")

" module m { ... }: export marks the definitions that stand directly in the "
"   body, which are the fields (peg_module) "
module_def ::= &(postfix ":=") f:ident nospace("(") &(def_params ")") ps:delimited(def_param, ",") ")" ":=" e:expr {
                   `DefFun{!f, !peg_lambda_defaults(ps, e)}
               }
             | x:ident ":=" e:expr { `Def{!x, !e} }
             | 'macro p:pattern ":=" e:expr { peg_macro(p, e) }
             | 'record n:ident "(" fs:idents ")" "=" !nospace("=") m:ident { peg_record(n, fs, m) }
             | module_expr

module_stmt ::= 'export d:module_def { `Export{!d} }
              | 'test b:block { `If{_testing, !b, none} }
              | expr

" the statements of a body, the last one first (a repetition holds at most 64 "
"   results) "
module_stmts ::= xs:module_stmts s:module_stmt ";"? { Cons{s, xs} }
               | s:module_stmt ";"? { Cons{s, Nil{}} }

module_expr ::= 'module n:ident "{" es:module_stmts "}" { peg_module(n, es) }
              | 'module n:ident "{" "}" { peg_module(n, Nil{}) }

" import a::b as m (x, y), import a::b (*), import a::b hiding (x, y): use of "
"   the file a/b loads it. "
" The module that is named like the last name of the path is a variable of the "
"   file. as m defines m as that module. "
" (x, y) defines x and y as the fields of the module, (*) defines all the "
"   fields, and hiding (x, y) all of them but x and y. "
import_option ::= same "(" "*" ")" { Tuple{'all, Tuple{}} }
             | same "(" ns:delimited1(ident, ",") ")" { Tuple{'some, ns} }
             | same 'hiding "(" ns:delimited1(ident, ",") ")" { Tuple{'hiding, ns} }

import_expr ::= 'import p:delimited1(ident, "::") a:(same 'as ident)? o:import_option? { peg_import(p, a, o) }

" f(p, ...) := e adds to f when f is already a variable of the place (DefFun) "
expr ::= syntax_decl
       | def_run
       | &(postfix ":=") f:ident nospace("(") &(def_params ")") ps:delimited(def_param, ",") ")" ":=" e:expr {
             `DefFun{!f, !peg_lambda_defaults(ps, e)}
         }
       | ns:destruct_names ":=" e:expr { peg_destruct('Def, ns, e) }
       | ns:destruct_names "=" !nospace("=") e:expr { peg_destruct('Set, ns, e) }
       | x:ident op:compound_op e:expr { peg_compound(x, op, e) }
       | a:postfix nospace("[") i:expr "]" op:compound_op v:expr { peg_index_update(a, i, op, v) }
       | x:target ":=" e:expr { `Def{!x, !e} }
       | &(postfix "=" !nospace("=")) f:ident nospace("(") ps:delimited(pattern, ",") ")" "=" !nospace("=") e:expr {
             `Set{!f, Fusion{!f, !peg_lambda(ps, e)}}
         }
       | x:target "=" !nospace("=") e:expr { `Set{!x, !e} }
       | 'fun f:ident !nospace("(") { `Def{!f, none} }
       | 'macro p:pattern ":=" e:expr { peg_macro(p, e) }
       | a:postfix nospace("[") i:expr "]" "=" !nospace("=") v:expr { `Apply{_index_set, Tuple{!a, !i, !v}} }
       | &(postfix 'with "{") w:with_expr { w }
       | union
       | 'record n:ident "(" fs:idents ")" "=" !nospace("=") m:ident { peg_record(n, fs, m) }
       | module_expr
       | import_expr

" a top-level expression ends with ; or a newline, or another expression "
"   follows "
toplevel ::= e:expr (";" | !same | &expr) { e }

peg_import(p, a, o) := {
    n := arity(p)
    file := sym_name(arg(p, 0))
    i := 1
    while (i < n) {
        file = str_cat(str_cat(file, "/"), sym_name(arg(p, i)))
        i = i + 1
    }
    m := arg(p, n - 1)
    load := `Apply{_import_module, Tuple{!file, Quote{!m}}}
    ds := Tuple{}
    if (arity(a) > 0) {
        name := arg(arg(a, 0), 2)
        ds = array_push(ds, `Def{!name, !load})
    } else ds = array_push(ds, load)
    if (arity(o) > 0) {
        kind := arg(arg(o, 0), 0)
        ns := arg(arg(o, 0), 1)
        if (kind == 'some) {
            j := 0
            while (j < arity(ns)) {
                x := arg(ns, j)
                ds = array_push(ds,
                    `Def{!x, Apply{_record_get, Tuple{!load, Quote{!x}}}})
                j = j + 1
            }
        } else {
            hidden := if (kind == 'hiding) ns else Tuple{}
            ds = array_push(ds,
                `Apply{eval,
                    Tuple{Apply{_import_defs, Tuple{!load, Quote{!hidden}}}}})
        }
    }
    expr('Do, array_push(ds, none))
}

" the name that a definition marked export defines: x for Def{x, e}, f for "
"   DefFun{f, e}, the type for a record "
peg_export_name(d) := if (head(d) == 'Def or head(d) == 'DefFun) arg(d, 0)
    else arg(arg(d, 1), 0)

" module n { ... }: reverse is the list of the statements of the body, the "
"   last one first. The module is "
" n := (() -> { statements; _module(names, values) })(). An M-expression holds "
"   at most 64 arguments, so "
" the statements are gathered in blocks of 32 (a block does not make a scope). "
peg_module(n, reverse) := {
    items := Nil{}
    while (head(reverse) == 'Cons) {
        items = Cons{arg(reverse, 0), items}
        reverse = arg(reverse, 1)
    }
    blocks := Tuple{}
    cur := Tuple{}
    names := Nil{}
    while (head(items) == 'Cons) {
        s := arg(items, 0)
        items = arg(items, 1)
        if (expr_type(s) == Expr and head(s) == 'Export) {
            d := arg(s, 0)
            if (head(d) != 'Macro) {
                names = Cons{peg_export_name(d), names}
                s = d
            }
        }
        cur = array_push(cur, s)
        if (arity(cur) == 32) {
            blocks = array_push(blocks, expr('Do, cur))
            cur = Tuple{}
        }
    }
    if (arity(cur) > 0) blocks = array_push(blocks, expr('Do, cur))
    blocks = array_push(blocks, `Apply{_module, Tuple{Quote{!names}, !names}})
    `Def{!n, Apply{Lambda{Tuple{}, !expr('Do, blocks)}, Tuple{}}}
}

" === Macro === "
" macro p := e is the tree Macro{f}, f being the function p -> e. It is not "
"   evaluated: the rewriting below "
" takes it out of the tree, adds f in front of the macros that apply from "
"   there on (the last arm gives the "
" tree itself), and leaves none in its place. A macro applies to the rest of "
"   the body of the innermost "
" function or module around it, and to the parts inside. export macro in a "
"   module also adds f to the "
" macros of the place around the module, after the module. Before eval takes "
"   an expression, each part of "
" its tree is rewritten by the macros, from the root down: a part is rewritten "
"   until it no longer changes, "
" then the parts inside the result are rewritten. A quote is not rewritten, "
"   and in a quasi-quote only what "
" is unquoted is rewritten. The patterns of a function and the names that Def "
"   and Set define are not rewritten. "
_macro_on := false
_macro := e -> e
" the macros that the module being rewritten exports, the last one first "
_macro_exports := Nil{}
_eval_expanded := eval
" a rewriting that takes more than _macro_limit steps in one eval stops with "
"   an error "
_macro_limit := 1000
_macro_steps := 0

" _macro_on is set when a macro is read, so that nothing is rewritten before "
"   the first macro "
peg_macro(p, e) := {
    _macro_on = true
    `Macro{!peg_lambda(Tuple{p}, e)}
}
fun expand_macro

" the tree whose arguments from index from on are rewritten at the quasi-quote "
"   level level "
expand_macro_args(e, level, from) := {
    n := arity(e)
    xs := Tuple{}
    i := 0
    while (i < n) {
        a := arg(e, i)
        xs = array_push(xs, if (i < from) a else expand_macro(a, level))
        i = i + 1
    }
    expr(head(e), xs)
}

" Macro{f}: the function of f is added to the macros, and none stays "
expand_macro_define(m, exported) := {
    f := _eval_expanded(expand_macro(arg(m, 0), 0))
    _macro = Fusion{f, _macro}
    if (exported) _macro_exports = Cons{f, _macro_exports}
    none
}

" a function or module body is a scope: the macros of its inside end with it, "
"   except the exported ones "
expand_macro_scope(e) := {
    saved := _macro
    saved_exports := _macro_exports
    _macro_exports = Nil{}
    r := expand_macro_args(e, 0, 1)
    xs := _macro_exports
    ys := Nil{}
    while (head(xs) == 'Cons) {
        ys = Cons{arg(xs, 0), ys}
        xs = arg(xs, 1)
    }
    _macro = saved
    while (head(ys) == 'Cons) {
        _macro = Fusion{arg(ys, 0), _macro}
        ys = arg(ys, 1)
    }
    _macro_exports = saved_exports
    r
}

expand_macro_sub(e, level) := {
    if (expr_type(e) != Expr) e
    else {
        h := head(e)
        if (h == 'QuasiQuote) expand_macro_args(e, level + 1, 0)
        else if (h == 'UnQuote) { if (level == 0) e
            else expand_macro_args(e, level - 1, 0) }
        else if (level > 0) expand_macro_args(e, level, 0)
        else if (h == 'Quote) e
        else if (h == 'Macro) expand_macro_define(e, false)
        else if (h == 'Export and expr_type(arg(e, 0)) == Expr and
            head(arg(e, 0)) == 'Macro) expand_macro_define(arg(e, 0), true)
        else if (h == 'Lambda) expand_macro_scope(e)
        else if (h == 'Def or h == 'Set or
            h == 'DefFun) expand_macro_args(e, 0, 1)
        else expand_macro_args(e, 0, 0)
    }
}

expand_macro = (e, level) -> {
    if (level != 0) expand_macro_sub(e, level)
    else {
        n := _macro(e)
        while (n != e) {
            _macro_steps = _macro_steps + 1
            if (_macro_steps > _macro_limit) perform Error{none,
                "macro expansion does not end"}
            e = n
            n = _macro(e)
        }
        expand_macro_sub(e, 0)
    }
}

" eval rewrites the tree by the macros first. Nothing is rewritten until the "
"   first macro is read. "
eval = e -> {
    if (_macro_on) {
        saved := _macro_steps
        _macro_steps = 0
        x := expand_macro(e, 0)
        _macro_steps = saved
        _eval_expanded(_rewrite_globals(x))
    } else _eval_expanded(_rewrite_globals(e))
}

" e with { f = v, ... } is _with(_with(e, 'f, v), 'g, w) ... _with is defined "
"   by record in the place of the record "
peg_with(o, fs) := {
    r := o
    i := 0
    while (i < arity(fs)) {
        r = `Apply{_with,
            Tuple{!r, Quote{!arg(arg(fs, i), 0)}, !arg(arg(fs, i), 1)}}
        i = i + 1
    }
    r
}

_record_with_error(t, name) := {
    os_put("no field ")
    os_put(sym_name(name))
    os_put(" in ")
    print(t, end = "")
    os_put("\n")
    os_exit(1)
}

" the function (d, name, v) -> a copy of the data d of the type t with the "
"   field name replaced by v. make makes the data of t. "
_record_with(t, make) := {
    fs := table_get(record_fields, t, none)
    (d @ t, name, v) -> {
        if (_record_index(d, name) == none) _record_with_error(d, name)
        args := Tuple{}
        i := 0
        while (i < arity(fs)) {
            args = array_push(args,
                expr('Quote, Tuple{if (arg(fs, i) == name) v else arg(d, i)}))
            i = i + 1
        }
        eval(expr('Apply, Tuple{expr('Quote, Tuple{make}), args}))
    }
}

" the names of (a, b, ...): Tuple{a, b, ...} "
peg_names(a, bs) := {
    names := Tuple{a}
    i := 0
    while (i < arity(bs)) {
        names = array_push(names, arg(bs, i))
        i = i + 1
    }
    names
}

" a variable that no program names "
peg_fresh() := {
    peg_fresh_count = peg_fresh_count + 1
    sym_intern(str_cat("%d", peg_itoa(peg_fresh_count)))
}

" record T(f, ...) = make defines T (the type) and make (the function that "
"   makes the data), and adds to _with the function "
" that copies a data of T with a field replaced (_record_with). _with is a "
"   variable of the place of the record, so a data "
" is copied only where the record is declared. %record is the variable that "
"   holds the type and make until they are named. "
peg_record(n, fs, m) := {
    r := sym_intern("%record")
    `Do{
        Def{!r, Apply{_record, Tuple{Quote{!n}, Quote{!fs}}}},
        Def{!n, Apply{arg, Tuple{!r, 0}}},
        Def{!m, Apply{arg, Tuple{!r, 1}}},
        DefFun{_with, Apply{_record_with, Tuple{!n, !m}}}
    }
}

" (a, b) := e is a block that defines a and b from the elements of the tuple "
"   e, and (a, b) = e "
" assigns them. kind is Def or Set. "
peg_destruct(kind, ns, e) := {
    names := peg_names(arg(ns, 0), arg(ns, 1))
    t := peg_fresh()
    items := Tuple{`Def{!t, !e}}
    i := 0
    while (i < arity(names)) {
        v := `Apply{_destructure, Tuple{!t, !i, !arity(names)}}
        items = array_push(items, if (kind == 'Def) `Def{!arg(names, i), !v}
            else `Set{!arg(names, i), !v})
        i = i + 1
    }
    expr('Do, items)
}

" the element i of t, which must be a tuple of n elements "
_destructure(t, i, n) := {
    if (expr_type(t) != Expr or head(t) != 'Tuple or arity(t) != n) {
        print(f"cannot assign {t} to {peg_itoa(n)} names")
        os_exit(1)
    }
    arg(t, i)
}

" x += e is x = x + e, and likewise for the other operators; op is the "
"   function of the operator "
peg_compound(x, op, e) := `Set{!x, Apply{!op, Tuple{!x, !e}}}

" a[i] += e is a[i] = a[i] + e, in which a and i are evaluated once "
peg_index_update(a, i, op, v) := {
    ta := peg_fresh()
    ti := peg_fresh()
    `Do{
        Def{!ta, !a},
        Def{!ti, !i},
        Apply{_index_set,
            Tuple{!ta, !ti,
                Apply{!op, Tuple{Apply{_index_get, Tuple{!ta, !ti}}, !v}}}}
    }
}

" === or in patterns, and the arms of a definition that goes on to the next "
"   === "

" p or q in a pattern is %or{p, q} (pattern). peg_pats takes the parameters ps "
"   and gives Tuple{ps2, test}: "
" every or is replaced by a variable %o1, ... and the test is true when the "
"   values of the variables "
" are among the alternatives. test is none when ps has no or. The alternatives "
"   bind no variables. "

peg_pat_var(p) := expr_type(p) == Symbol and p != '_ and p != 'true and
    p != 'false and p != 'none

" the variables of a pattern in order, pushed on the tuple acc "
peg_pat_names(p, acc) := {
    if (expr_type(p) == Symbol) {
        if (peg_pat_var(p)) acc = array_push(acc, p)
        return acc
    }
    if (expr_type(p) != Expr or head(p) == 'Quote) return acc
    n := if (head(p) == '_TypeOf) 1 else arity(p)
    i := 0
    while (i < n) {
        acc = peg_pat_names(arg(p, i), acc)
        i = i + 1
    }
    acc
}

" a name that is in the tuple twice, or none "
peg_pat_dup(ns) := {
    i := 0
    while (i < arity(ns)) {
        j := i + 1
        while (j < arity(ns)) {
            if (arg(ns, i) == arg(ns, j)) return arg(ns, i)
            j = j + 1
        }
        i = i + 1
    }
    none
}

peg_pat_has_or(p) := {
    if (expr_type(p) != Expr or head(p) == 'Quote) return false
    if (head(p) == peg_or) return true
    i := 0
    while (i < arity(p)) {
        if (peg_pat_has_or(arg(p, i))) return true
        i = i + 1
    }
    false
}

" the alternatives of p or q or ... pushed on the tuple acc "
peg_or_alts(p, acc) :=
    if (expr_type(p) == Expr and head(p) == peg_or) peg_or_alts(arg(p, 1),
        peg_or_alts(arg(p, 0), acc))
    else array_push(acc, p)

" the tests all true "
peg_conj(ts) := {
    acc := `true
    i := arity(ts) - 1
    while (i >= 0) {
        acc = `If{!arg(ts, i), !acc, false}
        i = i - 1
    }
    acc
}

" p with true, false and none written as Quote{true}, Quote{false} and "
"   Quote{none} "
peg_pat_literals(p) := {
    if (expr_type(p) == Symbol) return if (p == 'true or p == 'false or
        p == 'none) expr('Quote, Tuple{p}) else p
    if (expr_type(p) != Expr or head(p) == 'Quote) return p
    n := if (head(p) == '_TypeOf) 1 else arity(p)
    args := Tuple{}
    i := 0
    while (i < arity(p)) {
        args = array_push(args, if (i < n) peg_pat_literals(arg(p, i))
            else arg(p, i))
        i = i + 1
    }
    expr(head(p), args)
}

peg_pat_error(msg) := {
    print(f"error: {msg}")
    os_exit(1)
}

" a name made for the walk below: %o1, %d2, ... "
peg_fresh_n := 0
peg_fresh(pre) := {
    peg_fresh_n = peg_fresh_n + 1
    sym_intern(str_cat(pre, peg_itoa(peg_fresh_n)))
}

peg_has_name(ns, n) := {
    i := 0
    while (i < arity(ns)) {
        if (arg(ns, i) == n) return true
        i = i + 1
    }
    false
}

" every name of a is in b and every name of b is in a "
peg_same_names(a, b) := {
    i := 0
    while (i < arity(a)) {
        if (not peg_has_name(b, arg(a, i))) return false
        i = i + 1
    }
    i = 0
    while (i < arity(b)) {
        if (not peg_has_name(a, arg(b, i))) return false
        i = i + 1
    }
    true
}

" p with every or replaced by a variable and every name written a second time "
"   by a new variable. "
" st[0] is the tests, st[1] is Tuple{variable, alternatives} of the or that "
"   bind variables, "
" st[2] is the names seen and st[3] is the names of or. "
peg_pat_walk(p, st) := {
    if (expr_type(p) == Symbol) {
        if (not peg_pat_var(p)) return p
        if (peg_has_name(st[3], p)) peg_pat_error(
            str_cat("a variable of or is written more than once: ",
                sym_name(p)))
        if (peg_has_name(st[2], p)) {
            d := peg_fresh("%d")
            st[0] = array_push(st[0], `Apply{expr_eq, Tuple{!p, !d}})
            return d
        }
        st[2] = array_push(st[2], p)
        return p
    }
    if (expr_type(p) != Expr or head(p) == 'Quote) return p
    if (head(p) == peg_or) {
        alts := Tuple{}
        ns := Tuple{}
        i := 0
        alts0 := peg_or_alts(p, Tuple{})
        while (i < arity(alts0)) {
            a := peg_pat_literals(arg(alts0, i))
            ni := peg_pat_names(a, Tuple{})
            if (i > 0 and
                not peg_same_names(ns, ni)) peg_pat_error(
                "every alternative of or must bind the same variables")
            ns = ni
            alts = array_push(alts, a)
            i = i + 1
        }
        i = 0
        while (i < arity(ns)) {
            n := arg(ns, i)
            if (peg_has_name(st[2], n) and
                not peg_has_name(st[3], n)) peg_pat_error(
                str_cat("a variable of or is written more than once: ",
                    sym_name(n)))
            if (not peg_has_name(st[3], n)) {
                st[2] = array_push(st[2], n)
                st[3] = array_push(st[3], n)
            }
            i = i + 1
        }
        chain := `Lambda{Tuple{_}, false}
        i = arity(alts) - 1
        while (i >= 0) {
            chain = peg_fuse(peg_lambda(Tuple{arg(alts, i)}, `true), chain)
            i = i - 1
        }
        t := peg_fresh("%o")
        st[0] = array_push(st[0], `Apply{!chain, Tuple{!t}})
        if (arity(ns) > 0) {
            st[1] = array_push(st[1], Tuple{t, alts})
        }
        return t
    }
    n := if (head(p) == '_TypeOf) 1 else arity(p)
    args := Tuple{}
    i := 0
    while (i < arity(p)) {
        args = array_push(args, if (i < n) peg_pat_walk(arg(p, i), st)
            else arg(p, i))
        i = i + 1
    }
    expr(head(p), args)
}

" Tuple{ps2, test, wraps}: ps2 is ps without or and without a name written "
"   twice. The test is true when "
" the values are among the alternatives of or and the two values of a name are "
"   ==. The test is none when "
" there is nothing to test. wraps is for peg_wrap. "
peg_pats(ps) := {
    if (not peg_pat_has_or(ps) and
        peg_pat_dup(peg_pat_names(ps, Tuple{})) == none) return Tuple{ps, none,
        Tuple{}}
    st := array_new(4)
    st[0] = Tuple{}
    st[1] = Tuple{}
    st[2] = Tuple{}
    st[3] = Tuple{}
    ps2 := peg_pat_walk(ps, st)
    Tuple{ps2, peg_conj(st[0]), st[1]}
}

" the variables of an or are bound by matching its value again with each "
"   alternative: e is evaluated there "
peg_wrap(e, wraps) := {
    i := arity(wraps) - 1
    while (i >= 0) {
        t := arg(arg(wraps, i), 0)
        alts := arg(arg(wraps, i), 1)
        chain := peg_lambda(Tuple{arg(alts, arity(alts) - 1)}, e)
        j := arity(alts) - 2
        while (j >= 0) {
            chain = peg_fuse(peg_lambda(Tuple{arg(alts, j)}, e), chain)
            j = j - 1
        }
        e = `Apply{!chain, Tuple{!t}}
        i = i - 1
    }
    e
}

" a function whose parameters have or or a name twice is a function with the "
"   guard that the test makes "
peg_lambda_plain := peg_lambda
peg_guard_plain := peg_guard

peg_lambda = (ps, body) -> {
    r := peg_pats(ps)
    if (arg(r, 1) == none) peg_lambda_plain(ps, body)
        else peg_guard_plain(arg(r, 0), arg(r, 1), peg_wrap(body, arg(r, 2)))
}

peg_guard = (ps, c, e) -> {
    r := peg_pats(ps)
    if (arg(r, 1) == none) peg_guard_plain(ps, c, e)
    else peg_guard_plain(arg(r, 0),
        `If{!arg(r, 1), !peg_wrap(c, arg(r, 2)), false}, peg_wrap(e, arg(r, 2)))
}

" f(p, ...) := e and f(p, ...) if c := e. Tuple{f, special, function} where "
"   special is true when "
" the function has a guard or an or, which go on to the arms after it. "
peg_def_arm(f, ps0, g, e0) := {
    r := peg_defaults(ps0, e0)
    ps := arg(r, 0)
    e := arg(r, 1)
    sp := peg_pat_has_or(ps) or
        peg_pat_dup(peg_pat_names(ps, Tuple{})) != none or arity(g) > 0
    lambda := if (arity(g) > 0) peg_guard(ps, arg(arg(g, 0), 1), e)
        else peg_lambda(ps, e)
    Tuple{f, sp, lambda}
}

" The arguments of a call with names: the rest of the parameters is a Tuple of "
"   the arguments without names, and then _Kw{'name, value}. "
_kwis(x) := expr_type(x) == Expr and head(x) == '_Kw

" the number of the arguments without names "
_kwpos(rest) := {
    n := 0
    while (n < arity(rest) and not _kwis(arg(rest, n))) n = n + 1
    n
}

" the index in rest, from i on, of the argument named name, or -1 "
_kwfind(rest, name, i) := {
    while (i < arity(rest)) {
        if (_kwis(arg(rest, i)) and arg(arg(rest, i), 0) == name) return i
        i = i + 1
    }
    -1
}

_kwindex(names, name) := {
    i := 0
    while (i < arity(names)) {
        if (arg(names, i) == name) return i
        i = i + 1
    }
    -1
}

_kwfail(msg) := {
    print(f"error: {msg}")
    os_exit(1)
}

" _kwcheck(rest, names) stops the program for an argument that no parameter "
"   has, for too many arguments and for a parameter given twice "
_kwcheck(rest, names) := {
    n := _kwpos(rest)
    if (n > arity(names)) _kwfail("too many arguments")
    i := n
    while (i < arity(rest)) {
        name := arg(arg(rest, i), 0)
        j := _kwindex(names, name)
        if (j < 0) _kwfail(str_cat("unknown argument ", sym_name(name)))
        if (j < n or
            _kwfind(rest, name, i + 1) >=
            0) _kwfail(str_cat(sym_name(name), " is given twice"))
        i = i + 1
    }
}

" _kwarg(rest, i, name, thunk) is the argument named name, or the i-th one "
"   without a name, or thunk() "
_kwarg(rest, i, name, thunk) := {
    j := _kwfind(rest, name, 0)
    if (j >= 0) arg(arg(rest, j), 1) else if (i < _kwpos(rest)) arg(rest, i)
        else thunk()
}

" a definition of a special arm matches def_run with the definitions that "
"   follow it "
peg_token_special(p) := {
    q := peg_call_rule('def_arm, p)
    if (q < 0) return q
    v := peg_pv
    if (arg(v, 1)) {
        peg_pv = v
        return q
    }
    peg_fail(p)
}

_define_rule('special_arm, peg_token_special)

" The arms of the same f in a row are joined by | : f(p, ...) := e, f(q, ...) "
"   := e, ... is "
" Set{f, Fusion{f, p-arm | q-arm | ...}}. A guard or an or that does not apply "
"   goes on to the next arm. "
peg_def_run(a, rest) := {
    arms := array_push(Tuple{}, a)
    i := 0
    while (i < arity(rest)) {
        arms = array_push(arms, arg(arg(rest, i), 1))
        i = i + 1
    }
    stmts := Tuple{}
    i = 0
    while (i < arity(arms)) {
        f := arg(arg(arms, i), 0)
        j := i + 1
        while (j < arity(arms) and arg(arg(arms, j), 0) == f) j = j + 1
        lambda := arg(arg(arms, j - 1), 2)
        k := j - 2
        while (k >= i) {
            lambda = peg_fuse(arg(arg(arms, k), 2), lambda)
            k = k - 1
        }
        stmts = array_push(stmts,
            `DefFun{!f, !lambda})
        i = j
    }
    if (arity(stmts) == 1) arg(stmts, 0) else expr('Do, stmts)
}

def_arm ::= &(postfix (":=" | 'if)) f:ident nospace("(") &(def_params ")") ps:delimited(def_param, ",") ")" g:('if or_expr)? ":=" e:expr { peg_def_arm(f, ps, g, e) }

def_run ::= a:special_arm rest:(";"? def_arm)* { peg_def_run(a, rest) }

" === for === "
" for (p in xs) a is peg_for(xs, p -> a). It calls no function of a type but "
"   _iter: the elements of xs "
" are the ones that the iterator _iter(xs) gives. An iterator is a function "
"   next. next(end) is the next "
" element, or end itself when there is no more. peg_for makes a new end for "
"   each run, so no element is it. "
" A type is added by putting its arm in front of _iter (like _index_get): "
"     _iter = (Matrix{w, h, d}) -> { i := 0; (end) -> if (i < w * h) { i += 1; "
"       d[i - 1] } else end } | _iter "
" _iter has no arm for another value, and iterating over it is a call that no "
"   arm matches. "
" a list, from the first element to the end "
_iter(Cons{x, xs}) := {
    cur := Cons{x, xs}
    (end) -> if (head(cur) == 'Cons) {
        h := arg(cur, 0)
        cur = arg(cur, 1)
        h
    } else end
}
_iter(Nil{}) := (end) -> end

" a..b: the integers from a to b including b "
_iter(Range{a, b}) := {
    i := a
    (end) -> if (i <= b) {
        i += 1
        i - 1
    } else end
}

" an array and a plain array: the elements from 0 "
_iter(a @ Array) := {
    i := 0
    n := array_len(a)
    (end) -> if (i < n) {
        i += 1
        array_get(a, i - 1)
    } else end
}
_iter(a @ Plain) := {
    i := 0
    n := plain_len(a)
    (end) -> if (i < n) {
        i += 1
        plain_get(a, i - 1)
    } else end
}

" a table: Tuple{key, value} of each entry, in the order of table.items. The "
"   table must not change while it is walked. "
_iter(tb @ Table) := {
    b := array_get(arg(tb, 0), 0)
    n := array_len(b)
    i := 0
    e := none
    (end) -> {
        while (e == none and i < n) {
            e = array_get(b, i)
            i += 1
        }
        if (e == none) end else {
            r := Tuple{array_get(e, 0), array_get(e, 1)}
            e = array_get(e, 2)
            r
        }
    }
}

peg_for(xs, f) := {
    end := () -> none
    next := _iter(xs)
    x := next(end)
    while (x != end) {
        f(x)
        x = next(end)
    }
    none
}
