# Copyright (C) 2026 nineties

import test (*)

s := "hello"
check(s[0], "h")
check(s[4], "o")
check(s[1] == "e", true)
check(type(s[2]), String)
check(str_len(s[0]), 1)
check(str_ord(s[3], 0), 108)
check(str_sub(s, 1, 3), "el")

check(type(1), Int)
check(type("a"), String)
check(type('a), Symbol)
check(type(F{}), Expr)
check(type(x -> x), Function)
check(type(array_new(1)), Array)
check(type(parray_new_u8(1)), PArray)
check(match 1 { x @ Int -> true | _ -> false }, true)
check(match "a" { x @ Int -> true | _ -> false }, false)

b := parray_new_u8(4)
check(type(b), PArray)
check(parray_kind(b), 'u8)
check(parray_len(b), 4)
check(b[0], 0)
b[1] = 255
b[3] = 7
check(b[1], 255)
check(b[3], 7)
check(parray_get(b, 3), 7)
check(parray_set(b, 2, 9), none)
check(b[2], 9)

h := parray_new_u16(3)
check(parray_kind(h), 'u16)
h[0] = 65535
h[1] = 258
check(h[0], 65535)
check(h[1], 258)
check(h[2], 0)

w := parray_new_i32(3)
check(parray_kind(w), 'i32)
w[0] = -5
w[1] = 1073741823
w[2] = -1073741824
check(w[0], -5)
check(w[1], 1073741823)
check(w[2], -1073741824)
check(parray_len(parray_new_i32(0)), 0)

sum := 0
i := 0
while (i < 4) {
    sum = sum + b[i]
    i = i + 1
}
check(sum, 271)

c := parray_new_u8(6)
parray_copy(c, 1, b, 0, 4)
check(c[0], 0)
check(c[1], 0)
check(c[2], 255)
check(c[3], 9)
check(c[4], 7)
check(c[5], 0)
parray_copy(c, 0, c, 2, 3)
check(c[0], 255)
check(c[1], 9)
check(c[2], 7)
parray_copy(c, 2, c, 0, 3)
check(c[2], 255)
check(c[3], 9)
check(c[4], 7)

check(b == b, true)
check(b == parray_new_u8(4), false)

data := parray_new_u8(5)
data[0] = 0
data[1] = 65
data[2] = 0
data[3] = 255
data[4] = 10
check(os_write_bytes("tmp-builtins.bin", data), Ok{none})
back := unwrap(os_read_bytes("tmp-builtins.bin"))
check(parray_len(back), 5)
check(back[0], 0)
check(back[1], 65)
check(back[2], 0)
check(back[3], 255)
check(back[4], 10)
data = parray_new_u8(3)
data[0] = 97
data[1] = 0
data[2] = 122
os_write_bytes("tmp-builtins.bin", data)
back = unwrap(os_read_bytes("tmp-builtins.bin"))
check(parray_len(back), 3)
check(back[0], 97)
check(back[1], 0)
check(back[2], 122)

os_write_file("tmp-builtins.bin", "")
check(parray_len(unwrap(os_read_bytes("tmp-builtins.bin"))), 0)
check(os_read_file("tmp-builtins.bin"), Ok{""})
check(os_chmod("tmp-builtins.bin", 493), Ok{none})

check(os_read_file("tmp-no-such-file"), Err{IoError{'open, "tmp-no-such-file"}})
check(os_read_bytes("tmp-no-such-file"),
    Err{IoError{'open, "tmp-no-such-file"}})
check(os_read_file("planck"), Err{IoError{'read, "planck"}})
check(os_write_file("tmp-no-such-dir/x", "a"),
    Err{IoError{'open, "tmp-no-such-dir/x"}})
check(os_chmod("tmp-no-such-file", 493),
    Err{IoError{'chmod, "tmp-no-such-file"}})
check(unwrap(Ok{7}), 7)
check(
    handle unwrap(os_read_file("tmp-no-such-file")) with (Error{loc, msg}, k) ->
    msg, "open: tmp-no-such-file")

check(bit_and(12, 10), 8)
check(bit_or(12, 10), 14)
check(bit_xor(12, 10), 6)
check(bit_and(-1, 255), 255)
check(bit_and(-2, 7), 6)
check(bit_or(-8, 3), -5)
check(bit_xor(-1, 5), -6)
check(bit_xor(5, 5), 0)
check(bit_not(0), -1)
check(bit_not(5), -6)
check(bit_not(-1), 0)
check(bit_shl(1, 0), 1)
check(bit_shl(1, 10), 1024)
check(bit_shl(1, 29), 536870912)
check(bit_shl(-1, 30), -1073741824)
check(bit_shl(-1, 4), -16)
check(bit_sar(1024, 10), 1)
check(bit_sar(-1, 1), -1)
check(bit_sar(-1, 30), -1)
check(bit_sar(-1, 31), -1)
check(bit_sar(-1, 0), -1)
check(bit_sar(5, 1), 2)
check(bit_sar(-16, 2), -4)
check(bit_sar(-1, 30), -1)
check(bit_sar(-1, 31), -1)
check(bit_sar(1024, 3), 128)
check(bit_sar(-1073741824, 30), -1)
check(bit_and(bit_sar(0x2345678, 8), 255), 0x56)

args := os_argv()
check(type(args), Array)
check(array_len(args), 3)
check(args[0], "planck/tests/builtins.pk")
check(args[1], "one")
check(args[2], "two words")

finish()
