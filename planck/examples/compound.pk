x := 10
x += 5
print(x)
x -= 3
print(x)
x *= 2
print(x)
x /= 4
print(x)
x %= 4
print(x)

a := array(3)
a[0] = 1
a[1] = 2
a[2] = 3
a[1] *= 10
a[2] += a[1]
print(Tuple{a[0], a[1], a[2]})

n := 0
next() := {
    n += 1
    n - 1
}
a[next()] += 100
print(Tuple{a[0], a[1], n})

sum := 0
i := 1
while (i <= 10) {
    sum += i
    i += 1
}
print(sum)
