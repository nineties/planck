" init script for planck"
" Copyright (C) 2026 nineties "

" This script bootstraps Planck from its minimal core into a full-featured "
" programming language by leveraging its langugage extension capabilities. "

" === Builtin Symbols === "
Def{true, Quote{true}}
Def{false, Quote{false}}
Def{none, Quote{none}}

Def{put, os_put}
Def{read_file, os_read_file}
Def{write_file, os_write_file}
Def{read_bytes, os_read_bytes}
Def{chmod, os_chmod}
Def{list_dir, os_list_dir}
Def{argv, os_argv}
Def{exit, os_exit}
Def{time_ns, os_time_ns}
Def{run_program, os_run}
Def{head, expr_head}
Def{arity, expr_arity}
Def{arg, expr_arg}
Def{mexpr, expr_new}
Def{type, expr_type}
Def{typename, expr_type_name}
Def{strlen, str_len}
Def{ord, str_ord}
Def{substr, str_sub}
Def{hash, expr_hash}
Def{intern, sym_intern}
Def{symname, sym_name}
Def{array, array_new}
Def{push, array_push}
Def{u8_array, plain_u8}
Def{u16_array, plain_u16}
Def{i32_array, plain_i32}
Def{heap_allocated, gc_heap_allocated}
Def{expr_parse, parse}
Def{expr_eval, eval}

" === Types === "
" The types Int, String, Symbol, Expr, Function, Array, Plain and Type are values of planck0, and type(x) gives the type of x. "

" === Basic Functions === "
Def{_not, Fusion{
    Lambda{Tuple{Quote{false}}, true},
    Lambda{Tuple{_}, false}}}

" === Output === "
" _text(x) is the text of x on one line. A string is its characters, an integer is its decimal digits, a symbol is its name, an expression is its head and its arguments in braces. An array and a function are <array> and <function>. "
Def{_int_text, none}
Def{_args_text, none}
Def{_text, none}
Set{_int_text, Lambda{Tuple{n}, If{Apply{int_lt, Tuple{n, 0}}, Apply{str_cat, Tuple{"-", Apply{_int_text, Tuple{Apply{int_sub, Tuple{0, n}}}}}},
    If{Apply{int_lt, Tuple{n, 10}}, Apply{str_sub, Tuple{"0123456789", n, Apply{int_add, Tuple{n, 1}}}},
        Apply{str_cat, Tuple{Apply{_int_text, Tuple{Apply{int_div, Tuple{n, 10}}}}, Apply{_int_text, Tuple{Apply{int_mod, Tuple{n, 10}}}}}}}}}}
Set{_args_text, Lambda{Tuple{e, i}, If{Apply{int_ge, Tuple{i, Apply{arity, Tuple{e}}}}, "",
    Apply{str_cat, Tuple{Apply{_text, Tuple{Apply{arg, Tuple{e, i}}}},
        If{Apply{int_lt, Tuple{Apply{int_add, Tuple{i, 1}}, Apply{arity, Tuple{e}}}},
            Apply{str_cat, Tuple{", ", Apply{_args_text, Tuple{e, Apply{int_add, Tuple{i, 1}}}}}},
            ""}}}}}}
Set{_text, Lambda{Tuple{x}, Do{
    Def{t, Apply{type, Tuple{x}}},
    If{Apply{expr_eq, Tuple{t, String}}, x,
    If{Apply{expr_eq, Tuple{t, Int}}, Apply{_int_text, Tuple{x}},
    If{Apply{expr_eq, Tuple{t, Symbol}}, Apply{symname, Tuple{x}},
    If{Apply{expr_eq, Tuple{t, Expr}}, Apply{str_cat, Tuple{Apply{str_cat, Tuple{Apply{str_cat, Tuple{Apply{symname, Tuple{Apply{head, Tuple{x}}}}, "{"}}, Apply{_args_text, Tuple{x, 0}}}}, "}"}},
    If{Apply{expr_eq, Tuple{t, Array}}, "<array>",
    If{Apply{expr_eq, Tuple{t, Type}}, Apply{symname, Tuple{Apply{typename, Tuple{x}}}},
    If{Apply{expr_eq, Tuple{t, Function}}, "<function>",
    If{Apply{expr_eq, Tuple{t, Plain}}, "<function>",
    Apply{str_cat, Tuple{Apply{str_cat, Tuple{Apply{str_cat, Tuple{Apply{symname, Tuple{Apply{typename, Tuple{t}}}}, "{"}}, Apply{_args_text, Tuple{x, 0}}}}, "}"}}}}}}}}}}}}}
Def{_put_value, Lambda{Tuple{x}, Apply{os_put, Tuple{Apply{_text, Tuple{x}}}}}}
" print(x) writes _text(x) and a new line. Until lib/pretty.pk is loaded, which is at the end of this file, this is the print. lib/pretty.pk then sets print to write the value as pretty.text(x, 60) does, and takes the argument pretty, and sets repr. "
Def{print, Lambda{Tuple{x}, Do{Apply{_put_value, Tuple{x}}, Apply{os_put, Tuple{"\n"}}}}}
" repr(x) is the text of x that reads back as the same value. lib/pretty.pk defines it. "
Def{repr, none}

" === Tables === "
" A table is a Table, whose field is an array | buckets | number of entries |. Each bucket is a chain of entries "
" | key | value | next entry or none | hash of the key |. Keys are compared by eq. "
" The number of buckets doubles when there are more entries than buckets. "
Def{_table_type, Apply{expr_record, Tuple{Quote{Table}, Quote{Tuple{a}}}}}

Def{Table, Apply{arg, Tuple{_table_type, 0}}}

Def{_make_table, Apply{arg, Tuple{_table_type, 1}}}

Def{table_new, Lambda{Tuple{}, Do{
    Def{t, Apply{array, Tuple{2}}},
    Apply{array_set, Tuple{t, 0, Apply{array, Tuple{16}}}},
    Apply{array_set, Tuple{t, 1, 0}},
    Apply{_make_table, Tuple{t}}}}}

Def{table_find, Lambda{Tuple{t, k, h}, Do{
    Def{b, Apply{array_get, Tuple{t, 0}}},
    Def{e, Apply{array_get, Tuple{b, Apply{int_mod, Tuple{h, Apply{array_len, Tuple{b}}}}}}},
    While{If{Apply{expr_ne, Tuple{e, none}},
            If{Apply{expr_eq, Tuple{Apply{array_get, Tuple{e, 3}}, h}},
                Apply{expr_ne, Tuple{Apply{array_get, Tuple{e, 0}}, k}},
                true},
            false},
        Set{e, Apply{array_get, Tuple{e, 2}}}},
    e}}}

Def{table_get, Lambda{Tuple{_TypeOf{tb, Table}, k, default}, Do{
    Def{t, Apply{arg, Tuple{tb, 0}}},
    Def{e, Apply{table_find, Tuple{t, k, Apply{hash, Tuple{k}}}}},
    If{Apply{expr_eq, Tuple{e, none}}, default, Apply{array_get, Tuple{e, 1}}}}}}

Def{table_grow, Lambda{Tuple{t}, Do{
    Def{old, Apply{array_get, Tuple{t, 0}}},
    Def{m, Apply{int_mul, Tuple{Apply{array_len, Tuple{old}}, 2}}},
    Def{nb, Apply{array, Tuple{m}}},
    Def{i, 0},
    Def{e, none},
    Def{next, none},
    Def{j, 0},
    While{Apply{int_lt, Tuple{i, Apply{array_len, Tuple{old}}}}, Do{
        Set{e, Apply{array_get, Tuple{old, i}}},
        While{Apply{expr_ne, Tuple{e, none}}, Do{
            Set{next, Apply{array_get, Tuple{e, 2}}},
            Set{j, Apply{int_mod, Tuple{Apply{array_get, Tuple{e, 3}}, m}}},
            Apply{array_set, Tuple{e, 2, Apply{array_get, Tuple{nb, j}}}},
            Apply{array_set, Tuple{nb, j, e}},
            Set{e, next}}},
        Set{i, Apply{int_add, Tuple{i, 1}}}}},
    Apply{array_set, Tuple{t, 0, nb}}}}}

Def{table_set, Lambda{Tuple{_TypeOf{tb, Table}, k, v}, Do{
    Def{t, Apply{arg, Tuple{tb, 0}}},
    Def{h, Apply{hash, Tuple{k}}},
    Def{e, Apply{table_find, Tuple{t, k, h}}},
    If{Apply{expr_eq, Tuple{e, none}}, Do{
        Def{b, Apply{array_get, Tuple{t, 0}}},
        Def{i, Apply{int_mod, Tuple{h, Apply{array_len, Tuple{b}}}}},
        Def{n, Apply{array, Tuple{4}}},
        Apply{array_set, Tuple{n, 0, k}},
        Apply{array_set, Tuple{n, 1, v}},
        Apply{array_set, Tuple{n, 2, Apply{array_get, Tuple{b, i}}}},
        Apply{array_set, Tuple{n, 3, h}},
        Apply{array_set, Tuple{b, i, n}},
        Def{c, Apply{int_add, Tuple{Apply{array_get, Tuple{t, 1}}, 1}}},
        Apply{array_set, Tuple{t, 1, c}},
        If{Apply{int_gt, Tuple{c, Apply{array_len, Tuple{b}}}}, Apply{table_grow, Tuple{t}}, none}},
        Apply{array_set, Tuple{e, 1, v}}},
    none}}}

" === Results of files === "
" unwrap(r) is x for Ok{x}, and performs Error{none, message} for Err{IoError{stage, path}}. "
Def{unwrap, Lambda{Tuple{r}, If{Apply{expr_eq, Tuple{Apply{head, Tuple{r}}, Quote{Err}}},
    Perform{Error{none, Apply{str_cat, Tuple{Apply{str_cat, Tuple{Apply{symname, Tuple{Apply{arg, Tuple{Apply{arg, Tuple{r, 0}}, 0}}}}, ": "}},
        Apply{arg, Tuple{Apply{arg, Tuple{r, 0}}, 1}}}}}},
    Apply{arg, Tuple{r, 0}}}}}

" === Loading files === "
" load(path) parses and evaluates the file by the current parse and eval. "
" The top-level definitions of the file are made while path is the file being loaded. "
" A syntax error is printed as file:line:column: syntax error: message, once planck/syntax.pk has replaced parse and planck/peg.pk has defined peg_file_error_text. "
Def{peg_file_error_text, none}
Def{_parse0, parse}
Def{load, Lambda{Tuple{path}, Do{
    Def{s, Apply{unwrap, Tuple{Apply{read_file, Tuple{path}}}}},
    Def{s0, s},
    Def{prev, Apply{os_set_file, Tuple{path}}},
    Def{r, none},
    Def{e, none},
    Def{go, true},
    While{go, Do{
        Set{r, Apply{parse, Tuple{s}}},
        Set{e, Apply{arg, Tuple{r, 0}}},
        If{Apply{expr_eq, Tuple{e, Eof{}}}, Set{go, false},
        If{If{Apply{expr_eq, Tuple{Apply{type, Tuple{e}}, Expr}}, Apply{expr_eq, Tuple{Apply{head, Tuple{e}}, Quote{SyntaxError}}}, false},
            Do{
                Def{text, If{Apply{expr_ne, Tuple{parse, _parse0}}, Apply{peg_file_error_text, Tuple{path, s0, s}}, none}},
                If{Apply{expr_eq, Tuple{text, none}},
                    Do{
                        Apply{put, Tuple{path}},
                        Apply{put, Tuple{": syntax error: "}},
                        Apply{print, Tuple{e}}},
                    Apply{print, Tuple{text}}},
                Apply{exit, Tuple{1}}},
            Do{
                Apply{eval, Tuple{e}},
                Set{s, Apply{arg, Tuple{r, 1}}}}}}}},
    Apply{os_set_file, Tuple{prev}},
    none}}}

" === Syntax === "
" planck/syntax.pk replaces parse. The files after it are read by the new syntax. "
Apply{load, Tuple{"planck/peg.pk"}}
Apply{load, Tuple{"planck/syntax.pk"}}

" planck/lib/import.pk defines import_lib(name), which loads planck/lib/<name>.pk once. It is written in the syntax above. "
Apply{load, Tuple{"planck/lib/import.pk"}}

" planck/lib/pretty.pk defines show, repr and the print that takes pretty and end. It is loaded here, so that every program has them. "
Apply{import_lib, Tuple{"pretty"}}
