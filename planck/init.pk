" init script for planck"
" Copyright (C) 2026 nineties "

" This script bootstraps Planck from its minimal core into a full-featured "
" programming language by leveraging its langugage extension capabilities. "

" === Builtin Symbols === "
Def{true, Quote{true}}
Def{false, Quote{false}}
Def{none, Quote{none}}

Def{head, mexpr_head}
Def{arity, mexpr_arity}
Def{arg, mexpr_arg}
Def{mexpr, mexpr_new}
Def{typename, type_name}

" === Basic Functions === "
" text(x) is the text of x on one line. A string is its characters, an integer "
"   is its decimal digits, a symbol is its name, an expression is its head and "
"   its arguments in braces. An array and a function are <array> and "
"   <function>. "
Defun{text, Apply{Lambda{Tuple{}, Do{
    Defun{_args_text,
        Lambda{Tuple{e}, Do{
            Def{s, ""},
            Def{i, 0},
            While{Apply{int_lt, Tuple{i, Apply{arity, Tuple{e}}}}, Do{
                If{Apply{int_lt, Tuple{0, i}},
                    Set{s, Apply{str_cat, Tuple{s, ", "}}}, none},
                Set{s,
                    Apply{str_cat,
                        Tuple{s, Apply{text, Tuple{Apply{arg, Tuple{e, i}}}}}}},
                Set{i, Apply{int_add, Tuple{i, 1}}}}},
            s}}},
    Fusion{Lambda{Tuple{TypeOf{x, String}}, x},
    Fusion{Lambda{Tuple{TypeOf{x, Int}}, Apply{int_to_str, Tuple{x, 10}}},
    Fusion{Lambda{Tuple{TypeOf{x, Symbol}}, Apply{sym_name, Tuple{x}}},
    Fusion{
        Lambda{Tuple{TypeOf{x, Expr}},
            Apply{str_join,
                Tuple{Tuple{Apply{sym_name, Tuple{Apply{head, Tuple{x}}}}, "{",
                    Apply{_args_text, Tuple{x}}, "}"}}}},
    Fusion{Lambda{Tuple{TypeOf{x, Array}}, "<array>"},
    Fusion{
        Lambda{Tuple{TypeOf{x, Type}},
            Apply{sym_name, Tuple{Apply{typename, Tuple{x}}}}},
    Fusion{Lambda{Tuple{TypeOf{x, Function}}, "<function>"},
    Fusion{Lambda{Tuple{TypeOf{x, PackedArray}}, "<packed array>"},
    Lambda{Tuple{x},
        Apply{sym_name, Tuple{Apply{typename, Tuple{Apply{type, Tuple{x}}}}}}}}}}}}}}}}}, Tuple{}}}
" print(x) writes text(x) and a new line. Until lib/pretty.pk is loaded, which "
"   is at the end of this file, this is the print. lib/pretty.pk then sets "
"   print to write the value as pretty.text(x, 60) does, and takes the "
"   argument pretty, and sets repr. The argument end = s writes s in place of "
"   the new line (here, the first argument with a name is taken as end). "
Def{print,
    Lambda{Tuple{x, Rest{_kwrest}},
        Do{Apply{os_put, Tuple{Apply{text, Tuple{x}}}},
            If{Apply{int_lt, Tuple{0, Apply{arity, Tuple{_kwrest}}}},
                Apply{os_put,
                    Tuple{Apply{arg, Tuple{Apply{arg, Tuple{_kwrest, 0}}, 1}}}},
                Apply{os_put, Tuple{"\n"}}}}}}

" === Tables === "
" A table is a Table, whose field is an array | buckets | number of entries |. "
"   Each bucket is a chain of entries "
" | key | value | next entry or none | hash of the key |. Keys are compared by "
"   eq. "
" The number of buckets doubles when there are more entries than buckets. "
Def{Table, none}

Def{table_new, none}
Def{table_len, none}
Def{table_has, none}
Def{table_iter, none}
Def{table_get, none}
Def{table_set, none}

Apply{Lambda{Tuple{}, Do{
    Def{_table_type, Apply{type_new, Tuple{Quote{Table}}}},
    Set{Table, Apply{arg, Tuple{_table_type, 0}}},
    Def{_wrap_table, Apply{arg, Tuple{_table_type, 1}}},
    Def{_unwrap_table, Apply{arg, Tuple{_table_type, 2}}},
    Def{_table_find, Lambda{Tuple{t, k, h}, Do{
        Def{b, Apply{array_get, Tuple{t, 0}}},
        Def{e,
            Apply{array_get,
                Tuple{b, Apply{int_mod, Tuple{h, Apply{array_len, Tuple{b}}}}}}},
        While{If{Apply{not_equal, Tuple{e, none}},
                If{Apply{equal, Tuple{Apply{array_get, Tuple{e, 3}}, h}},
                    Apply{not_equal, Tuple{Apply{array_get, Tuple{e, 0}}, k}},
                    true},
                false},
            Set{e, Apply{array_get, Tuple{e, 2}}}},
        e}}},
    Set{table_new, Lambda{Tuple{}, Do{
        Def{t, Apply{array_new, Tuple{2}}},
        Apply{array_set, Tuple{t, 0, Apply{array_new, Tuple{16}}}},
        Apply{array_set, Tuple{t, 1, 0}},
        Apply{_wrap_table, Tuple{Tuple{t}}}}}},
    Set{table_get, Lambda{Tuple{TypeOf{tb, Table}, k, default}, Do{
        Def{t, Apply{arg, Tuple{Apply{_unwrap_table, Tuple{tb}}, 0}}},
        Def{e, Apply{_table_find, Tuple{t, k, Apply{hash, Tuple{k}}}}},
        If{Apply{equal, Tuple{e, none}}, default,
            Apply{array_get, Tuple{e, 1}}}}}},
    Set{table_set, Apply{Lambda{Tuple{}, Do{
        Def{table_grow, Lambda{Tuple{t}, Do{
            Def{old, Apply{array_get, Tuple{t, 0}}},
            Def{m, Apply{int_mul, Tuple{Apply{array_len, Tuple{old}}, 2}}},
            Def{nb, Apply{array_new, Tuple{m}}},
            Def{i, 0},
            Def{e, none},
            Def{next, none},
            Def{j, 0},
            While{Apply{int_lt, Tuple{i, Apply{array_len, Tuple{old}}}}, Do{
                Set{e, Apply{array_get, Tuple{old, i}}},
                While{Apply{not_equal, Tuple{e, none}}, Do{
                    Set{next, Apply{array_get, Tuple{e, 2}}},
                    Set{j, Apply{int_mod, Tuple{Apply{array_get, Tuple{e, 3}}, m}}},
                    Apply{array_set, Tuple{e, 2, Apply{array_get, Tuple{nb, j}}}},
                    Apply{array_set, Tuple{nb, j, e}},
                    Set{e, next}}},
                Set{i, Apply{int_add, Tuple{i, 1}}}}},
            Apply{array_set, Tuple{t, 0, nb}}}}},
        Lambda{Tuple{TypeOf{tb, Table}, k, v}, Do{
            Def{t, Apply{arg, Tuple{Apply{_unwrap_table, Tuple{tb}}, 0}}},
            Def{h, Apply{hash, Tuple{k}}},
            Def{e, Apply{_table_find, Tuple{t, k, h}}},
            If{Apply{equal, Tuple{e, none}}, Do{
                Def{b, Apply{array_get, Tuple{t, 0}}},
                Def{i, Apply{int_mod, Tuple{h, Apply{array_len, Tuple{b}}}}},
                Def{n, Apply{array_new, Tuple{4}}},
                Apply{array_set, Tuple{n, 0, k}},
                Apply{array_set, Tuple{n, 1, v}},
                Apply{array_set, Tuple{n, 2, Apply{array_get, Tuple{b, i}}}},
                Apply{array_set, Tuple{n, 3, h}},
                Apply{array_set, Tuple{b, i, n}},
                Def{c, Apply{int_add, Tuple{Apply{array_get, Tuple{t, 1}}, 1}}},
                Apply{array_set, Tuple{t, 1, c}},
                If{Apply{int_gt, Tuple{c, Apply{array_len, Tuple{b}}}},
                    Apply{table_grow, Tuple{t}}, none}},
                Apply{array_set, Tuple{e, 1, v}}},
            none}}}}, Tuple{}}},
    Set{table_len, Lambda{Tuple{TypeOf{tb, Table}}, Do{
        Apply{array_get, Tuple{Apply{arg, Tuple{Apply{_unwrap_table, Tuple{tb}}, 0}}, 1}}}}},
    Set{table_has, Lambda{Tuple{TypeOf{tb, Table}, k}, Do{
        Def{t, Apply{arg, Tuple{Apply{_unwrap_table, Tuple{tb}}, 0}}},
        Apply{not_equal, Tuple{Apply{_table_find, Tuple{t, k, Apply{hash, Tuple{k}}}}, none}}}}},
    Set{table_iter, Lambda{Tuple{TypeOf{tb, Table}}, Do{
        Def{b, Apply{array_get, Tuple{Apply{arg, Tuple{Apply{_unwrap_table, Tuple{tb}}, 0}}, 0}}},
        Def{n, Apply{array_len, Tuple{b}}},
        Def{i, 0},
        Def{e, none},
        Lambda{Tuple{end}, Do{
            While{If{Apply{equal, Tuple{e, none}}, Apply{int_lt, Tuple{i, n}}, false},
                Do{Set{e, Apply{array_get, Tuple{b, i}}},
                    Set{i, Apply{int_add, Tuple{i, 1}}}}},
            If{Apply{equal, Tuple{e, none}}, end, Do{
                Def{r, Tuple{Apply{array_get, Tuple{e, 0}}, Apply{array_get, Tuple{e, 1}}}},
                Set{e, Apply{array_get, Tuple{e, 2}}},
                r}}}}}}}}}, Tuple{}}

" === Results of files === "
" unwrap(r) is x for Ok{x}, and performs Error{none, message} for "
"   Err{IoError{stage, path}}. "
Defun{unwrap,
    Lambda{Tuple{Err{e}},
    Perform{
        Error{none,
            Apply{str_join,
                Tuple{Tuple{Apply{sym_name, Tuple{Apply{arg, Tuple{e, 0}}}}, ": ",
                    Apply{arg, Tuple{e, 1}}}}}}}}}
Defun{unwrap, Lambda{Tuple{r}, Apply{arg, Tuple{r, 0}}}}

" === Loading files === "
" load(path, env) parses and evaluates the file in env by the current parse and eval. "
" The top-level definitions of the file are made while path is the file being "
"   loaded. "
" load reads the file statement by statement: parse(s) of the rest s. "
" A syntax error is printed as file:line:column: syntax error: message. The "
"   parse of planck/syntax.pk performs Origin{}, which load answers with the "
"   position of the rest being read, and SyntaxFault{text}. "
Def{load, Apply{Lambda{Tuple{}, Do{
    Lambda{Tuple{path, env}, Do{
        Def{s, Apply{unwrap, Tuple{Apply{os_read_file, Tuple{path}}}}},
        Def{s0, s},
        Def{origin, Lambda{Tuple{}, Do{
            Def{n,
                Apply{int_sub,
                    Tuple{Apply{str_len, Tuple{s0}}, Apply{str_len, Tuple{s}}}}},
            Def{l, 1},
            Def{c, 1},
            Def{i, 0},
            While{Apply{int_lt, Tuple{i, n}}, Do{
                If{Apply{equal, Tuple{Apply{str_ord, Tuple{s0, i}}, 10}},
                    Do{Set{l, Apply{int_add, Tuple{l, 1}}}, Set{c, 1}},
                    Set{c, Apply{int_add, Tuple{c, 1}}}},
                Set{i, Apply{int_add, Tuple{i, 1}}}}},
            Apply{mexpr, Tuple{Quote{Loc}, Tuple{path, l, c}}}}}},
        Def{r, none},
        Def{e, none},
        Def{go, true},
        While{go, Do{
            Set{r,
                Handle{Apply{parse, Tuple{s}},
                    Lambda{Tuple{x, k},
                        If{Apply{equal, Tuple{Apply{head, Tuple{x}},
                                Quote{Origin}}},
                            Apply{k, Tuple{Apply{origin, Tuple{}}}},
                            Do{
                                Apply{print, Tuple{Apply{arg, Tuple{x, 0}}}},
                                Apply{os_exit, Tuple{1}}}}}}},
            Set{e, Apply{arg, Tuple{r, 0}}},
            If{Apply{equal, Tuple{e, Eof{}}}, Set{go, false},
            If{
                If{Apply{equal, Tuple{Apply{type, Tuple{e}}, Expr}},
                    Apply{equal,
                        Tuple{Apply{head, Tuple{e}},
                            Quote{SyntaxError}}}, false},
                Do{
                    Apply{os_put, Tuple{path}},
                    Apply{os_put, Tuple{": syntax error: "}},
                    Apply{print, Tuple{e}},
                    Apply{os_exit, Tuple{1}}},
                Do{
                    Apply{eval, Tuple{e, env}},
                    Set{s, Apply{arg, Tuple{r, 1}}}}}}}},
        none}}}}, Tuple{}}}

" === Vectors === "
" A vector is an array that grows. vector_new() makes an empty one, "
"   vector_push(v, x) adds x at the end, vector_len(v) is the length, "
"   vector_get(v, i) is the element i and vector_truncate(v, n) sets the length n. "
Def{vector_new, Lambda{Tuple{}, Do{
    Def{v, Apply{array_new, Tuple{2}}},
    Apply{array_set, Tuple{v, 0, Apply{array_new, Tuple{64}}}},
    Apply{array_set, Tuple{v, 1, 0}},
    v}}}

Def{vector_len, Lambda{Tuple{v}, Apply{array_get, Tuple{v, 1}}}}

Def{vector_get, Lambda{Tuple{v, i},
    Apply{array_get, Tuple{Apply{array_get, Tuple{v, 0}}, i}}}}

Def{vector_truncate, Lambda{Tuple{v, n}, Apply{array_set, Tuple{v, 1, n}}}}

Def{vector_push, Lambda{Tuple{v, x}, Do{
    Def{buf, Apply{array_get, Tuple{v, 0}}},
    Def{n, Apply{array_get, Tuple{v, 1}}},
    If{Apply{int_lt, Tuple{n, Apply{array_len, Tuple{buf}}}}, none, Do{
        Def{bigger, Apply{array_new, Tuple{Apply{int_mul, Tuple{n, 2}}}}},
        Def{i, 0},
        While{Apply{int_lt, Tuple{i, n}}, Do{
            Apply{array_set, Tuple{bigger, i, Apply{array_get, Tuple{buf, i}}}},
            Set{i, Apply{int_add, Tuple{i, 1}}}}},
        Apply{array_set, Tuple{v, 0, bigger}},
        Set{buf, bigger}}},
    Apply{array_set, Tuple{buf, n, x}},
    Apply{array_set, Tuple{v, 1, Apply{int_add, Tuple{n, 1}}}},
    x}}}

" === Syntax === "
" planck/syntax.pk replaces parse. The files after it are read by the new "
"   syntax. "
Apply{load, Tuple{"planck/peg.pk", Apply{env_global, Tuple{}}}}
Apply{load, Tuple{"planck/syntax.pk", Apply{env_global, Tuple{}}}}

" planck/lib/import.pk defines import_lib(name), which loads "
"   planck/lib/<name>.pk once. It is written in the syntax above. "
load("planck/lib/import.pk", env_global())

" planck/lib/pretty.pk defines show, repr and the print that takes pretty and "
"   end. It is loaded here, so that every program has them. "
import_lib("pretty")
