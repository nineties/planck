import_lib("base")
import_lib("string")

module error {
    export line_col(src, pos) := {
        n := if (pos < str_len(src)) pos else str_len(src)
        line := 1
        start := 0
        i := str_find(src, "\n", 0)
        while (i >= 0 and i < n) {
            line = line + 1
            start = i + 1
            i = str_find(src, "\n", start)
        }
        Tuple{line, n - start + 1}
    }

    export line_text(src, line) := {
        i := 0
        l := 1
        while (l < line and i < str_len(src)) {
            j := str_find(src, "\n", i)
            i = if (j < 0) str_len(src) else j + 1
            l = l + 1
        }
        j := str_find(src, "\n", i)
        str_sub(src, i, if (j < 0) str_len(src) else j)
    }

    export loc_at(file, src, pos) := {
        lc := line_col(src, pos)
        Loc{file, arg(lc, 0), arg(lc, 1)}
    }

    export show_loc := (Loc{file, line, col}) -> f"{file}:{line}:{col}"

    export at(loc, msg) := perform Error{loc, msg}

    export catch(f) := handle Ok{f()} with (Error{loc, msg}, k) ->
        Error{loc, msg}

    export show(src, loc, msg) := {
        b := strbuf.new()
        strbuf.add(b, show_loc(loc))
        strbuf.add(b, ": ")
        strbuf.add(b, msg)
        strbuf.add(b, "\n  ")
        strbuf.add(b, line_text(src, arg(loc, 1)))
        strbuf.add(b, "\n  ")
        strbuf.add(b, string.string_repeat(" ", arg(loc, 2) - 1))
        strbuf.add(b, "^")
        strbuf.string(b)
    }
}
