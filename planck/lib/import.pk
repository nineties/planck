# Copyright (C) 2026 nineties

used_libs := table_new()

import_lib := (() -> {
    grammar_chain := f"{hash(unwrap(os_read_file("planck/init.pk")))}.{hash(unwrap(os_read_file("planck/peg.pk")))}.{hash(unwrap(os_read_file("planck/syntax.pk")))}"
    grammar_state() := f"{grammar_chain}@{peg_version}"

    preprocess_hook := none

    read_preprocessed(path, state, text) := {
        s := match os_read_file(path) {
            Ok{text} -> text
          | Err{_} -> none
        }
        if (s == none) return none
        r := parse_mexpr(s)
        h := arg(r, 0)
        if (type(h) != Expr or head(h) != 'Preprocessed or
            arity(h) != 2) return none
        if (arg(h, 0) != state or arg(h, 1) != text) return none
        s = arg(r, 1)
        acc := []
        n := 0
        go := true
        while (go) {
            r = parse_mexpr(s)
            e := arg(r, 0)
            if (e == Eof{}) go = false
            else if (type(e) == Expr and
                head(e) == 'SyntaxError) return none
            else {
                acc = e :: acc
                n = n + 1
                s = arg(r, 1)
            }
        }
        if (acc == []) return none
        last := arg(acc, 0)
        if (type(last) != Expr or head(last) != 'PreprocessEnd or
            arity(last) != 1 or arg(last, 0) != n - 1) return none
        reverse(arg(acc, 1))
    }

    load_lib(name) :=
        if (table_get(used_libs, name, false)) none else {
        table_set(used_libs, name, true)
        path := f"planck/lib/{name}.pk"
        text := unwrap(os_read_file(path))
        state := grammar_state()
        declared := peg_version
        if (preprocess_hook != none) preprocess_hook(name, path, state, text)
        else {
            trees := read_preprocessed(f"planck/lib/{name}.pkm", state, text)
            if (trees == none) load(path)
            else {
                prev := _file_defs
                _file_defs = table_new()
                for (e in trees) eval(e)
                _file_defs = prev
            }
        }
        if (peg_version != declared) grammar_chain = f"{grammar_chain}:{name}={hash(text)}"
        none
    }

    load_lib
})()

" the module that import loads: use of the file loads it, and the module is "
"   the variable of the name m "
_import_module(file, m) := {
    import_lib(file)
    eval(m)
}

" the definitions of the fields of the module that are not in hidden, which "
"   import runs by eval "
_import_defs(m @ Module, hidden) := {
    ds := stack_mark()
    for (Tuple{k, v} in arg(_fields(m), 0)) {
        skip := false
        for (h in hidden) if (h == k) skip = true
        if (not skip) stack_push(`Def{!k, Quote{!v}})
    }
    stack_push(none)
    stack_expr('Do, ds)
}
