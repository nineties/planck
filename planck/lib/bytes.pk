import_lib("list")
import_lib("vector")

module bytes {
    export new() := vector.new()
    export len(b) := vector.len(b)

    export u8(b, n) := vector.push(b, bit_and(n, 255))

    export u16(b, n) := {
        u8(b, n)
        u8(b, bit_sar(n, 8))
    }

    export u32(b, n) := {
        u8(b, n)
        u8(b, bit_sar(n, 8))
        u8(b, bit_sar(n, 16))
        u8(b, bit_sar(n, 24))
    }

    export u64(b, n) := {
        u32(b, n)
        u32(b, bit_sar(n, 32))
    }

    export string(b, s) := {
        for (i in 0..str_len(s) - 1) u8(b, str_ord(s, i))
    }

    export zeros(b, n) := {
        for (_ in 1..n) u8(b, 0)
    }

    export align(b, a) := {
        while (len(b) % a != 0) u8(b, 0)
    }

    export append(b, c) := {
        for (x in c) u8(b, x)
    }

    export get(b, i) := vector.get(b, i)
    export set(b, i, n) := vector.set(b, i, bit_and(n, 255))

    export set_u32(b, at, n) := {
        set(b, at, n)
        set(b, at + 1, bit_sar(n, 8))
        set(b, at + 2, bit_sar(n, 16))
        set(b, at + 3, bit_sar(n, 24))
    }

    export to_u8(b) := {
        n := len(b)
        a := parray_new_u8(n)
        for (i in 0..n - 1) a[i] = vector.get(b, i)
        a
    }
}
