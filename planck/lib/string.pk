import_lib("base")
import_lib("list")
import_lib("vector")

module strbuf {
    export new() := vector.new()
    export add(b, s) := vector.push(b, s)
    export string(b) := {
        n := vector.len(b)
        if (n == 0) "" else {
            a := array_new(n)
            i := 0
            while (i < n) {
                array_set(a, i, vector.get(b, i))
                i = i + 1
            }
            m := n
            while (m > 1) {
                i = 0
                j := 0
                while (i + 1 < m) {
                    array_set(a, j,
                        str_cat(array_get(a, i), array_get(a, i + 1)))
                    i = i + 2
                    j = j + 1
                }
                if (i < m) {
                    array_set(a, j, array_get(a, i))
                    j = j + 1
                }
                m = j
            }
            array_get(a, 0)
        }
    }
}

module string {
    export is_digit(c) := c >= 48 and c <= 57
    export is_upper(c) := c >= 65 and c <= 90
    export is_lower(c) := c >= 97 and c <= 122
    export is_alpha(c) := is_upper(c) or is_lower(c)
    export is_alnum(c) := is_alpha(c) or is_digit(c)
    export is_space(c) := c == 32 or c == 9 or c == 10 or c == 13
    export is_ident_start(c) := is_alpha(c) or c == 95
    export is_ident_char(c) := is_alnum(c) or c == 95

    export ascii_printable := " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"

    export char(c) := if (c == 10) "\n"
              else if (c == 9) "\t"
              else if (c == 13) "\r"
              else if (c >= 32 and c <= 126) str_sub(ascii_printable,
                  c - 32, c - 31)
              else panic("char: unsupported code")

    export char_at(s, i) := if (i < 0 or i >= str_len(s)) ""
        else str_sub(s, i, i + 1)

    export starts_with(s, p) := str_len(p) <= str_len(s) and
        str_sub(s, 0, str_len(p)) == p
    export ends_with(s, p) := str_len(p) <= str_len(s) and
        str_sub(s, str_len(s) - str_len(p), str_len(s)) == p

    export index_of_string(s, part, from) := {
        for (i in range(from, str_len(s) - str_len(part) + 1)) {
            if (str_sub(s, i, i + str_len(part)) == part) return i
        }
        -1
    }

    export string_repeat(s, n) := {
        r := ""
        while (n > 0) {
            r = str_cat(r, s)
            n = n - 1
        }
        r
    }

    export string_cmp(a, b) := {
        i := 0
        r := 0
        n := if (str_len(a) < str_len(b)) str_len(a) else str_len(b)
        while (r == 0 and i < n) {
            r = if (str_ord(a, i) < str_ord(b, i)) -1
                else if (str_ord(a, i) > str_ord(b, i)) 1 else 0
            i = i + 1
        }
        if (r != 0) r else if (str_len(a) < str_len(b)) -1
            else if (str_len(a) > str_len(b)) 1 else 0
    }

    export string_less(a, b) := string_cmp(a, b) < 0

    export trim(s) := {
        i := 0
        j := str_len(s)
        while (i < j and is_space(str_ord(s, i))) i = i + 1
        while (j > i and is_space(str_ord(s, j - 1))) j = j - 1
        str_sub(s, i, j)
    }

    export int_to_string(n) := if (n < 0) str_cat("-", int_to_string(0 - n))
                     else if (n < 10) str_sub("0123456789", n, n + 1)
                     else str_cat(int_to_string(n / 10), int_to_string(n % 10))

    export string_to_int(s) := {
        n := str_len(s)
        neg := n > 0 and str_ord(s, 0) == 45
        i := if (neg) 1 else 0
        v := 0
        ok := i < n
        while (ok and i < n) {
            if (is_digit(str_ord(s, i))) v = v * 10 - (str_ord(s, i) - 48)
                else ok = false
            i = i + 1
        }
        if (not ok) none else if (neg) v else 0 - v
    }

    export split(s, sep) := {
        if (str_len(sep) == 0) panic("split: empty separator")
        r := []
        start := 0
        i := index_of_string(s, sep, 0)
        while (i >= 0) {
            r = str_sub(s, start, i) :: r
            start = i + str_len(sep)
            i = index_of_string(s, sep, start)
        }
        reverse(str_sub(s, start, str_len(s)) :: r)
    }

    export join(sep, xs) := {
        b := strbuf.new()
        first := true
        each(x -> {
            if (not first) strbuf.add(b, sep)
            first = false
            strbuf.add(b, x)
        }, xs)
        strbuf.string(b)
    }
}

join := string.join
